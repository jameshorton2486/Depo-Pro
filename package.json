    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/supabase-backup.ps1",
    "db:regenerate-types": "npx supabase gen types typescript --project-id ildhcfspbmhuemzgvzyx > types/supabase-generated.ts",
    "db:deploy-v13-types": "powershell -ExecutionPolicy Bypass -File scripts/deploy-v13-regenerate-types.ps1",
    "security:isolation-suite": "powershell -ExecutionPolicy Bypass -File scripts/run-isolation-suite.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:auth": "playwright test tests/e2e/auth.spec.ts",
    "verify:rls": "tsx scripts/verify-rls.ts",
    "verify:key": "powershell -ExecutionPolicy Bypass -File scripts/verify-publishable-key.ps1",
    "restart:hard": "powershell -ExecutionPolicy Bypass -File scripts/hard-restart.ps1",
    "update:keys": "powershell -ExecutionPolicy Bypass -File scripts/update-supabase-keys.ps1",
    "check:html": "tsx scripts/check-html-structure.ts",
    "check:enums": "tsx scripts/check-enum-usage.ts",
    "verify:prod": "tsx scripts/verify-production.ts",
    "check:permissions": "tsx scripts/check-permission-drift.ts",
    "check:routes": "tsx scripts/check-route-coverage.ts",
    "audit:design": "tsx scripts/audit-design-system.ts",
    "nav:normalize": "tsx scripts/normalize-navigation.ts",
    "nav:audit": "tsx scripts/nav-audit.ts",
    "report:permissions": "tsx scripts/generate-permission-diff.ts",
    "vercel-build": "next build",
    "logs": "node scripts/view-logs.js",
    "logs:auth": "node scripts/view-logs.js auth",
    "logs:errors": "node scripts/view-logs.js --errors",
    "logs:clear": "powershell -Command \"Remove-Item -Path logs\\*.log -ErrorAction SilentlyContinue\""
