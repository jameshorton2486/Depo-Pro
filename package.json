        "prepare": "husky",
        "postinstall": "prisma generate",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:migrate:prod": "prisma migrate deploy",
        "db:seed": "tsx prisma/seed.ts",
        "db:seed:prod": "tsx scripts/seed-production.ts",
        "create-test-users": "tsx scripts/create-test-users.ts",
        "db:studio": "prisma studio",
        "db:reset": "prisma migrate reset",
        "db:check-drift": "tsx scripts/check-prisma-drift.ts",
        "db:validate": "prisma validate",
        "test": "jest",
        "check:enums": "tsx scripts/check-enum-usage.ts",
        "verify:prod": "tsx scripts/verify-production.ts",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "vercel-build": "prisma generate && prisma migrate deploy && next build"
    },
