{
  "name": "depo-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "check:all": "npm run format:check && npm run lint && npm run typecheck && npm run build",
    "check:version": "node scripts/check-next-version.js",
    "check:env": "node scripts/check-env-vars.js",
    "security:scan": "node scripts/security/scan-secrets.js",
    "security:scan:staged": "node scripts/security/scan-secrets.js --staged",
    "prepare": "husky",
    "db:setup-urls": "powershell -ExecutionPolicy Bypass -File scripts/setup-database-urls.ps1",
    "db:validate-urls": "powershell -ExecutionPolicy Bypass -File scripts/validate-database-urls.ps1",
    "create-test-users": "tsx scripts/create-test-users.ts",
    "test-credentials": "tsx scripts/test-credentials.ts",
    "test-env-vars": "powershell -ExecutionPolicy Bypass -File scripts/test-env-vars.ps1",
