# ==================================
# DEPO-PRO PRODUCTION ENVIRONMENT
# ==================================
# Copy this file and configure for production deployment
# DO NOT commit secrets to git!

# ==================================
# CORE INFRASTRUCTURE
# ==================================

# Database (Supabase or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/database"
DIRECT_URL="postgresql://user:password@host:5432/database"

# App URL
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Node Environment
NODE_ENV="production"

# ==================================
# API KEYS
# ==================================

# Deepgram AI Transcription (REQUIRED)
DEEPGRAM_API_KEY="your-deepgram-api-key"

# OpenAI (Optional - for future AI features)
OPENAI_API_KEY="your-openai-api-key"

# ==================================
# SUPABASE (Storage & Database)
# ==================================

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_key_here"
SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_anon_your_key_here"

# Webhook verification
WEBHOOK_SECRET="your-webhook-signing-secret"
DEEPGRAM_WEBHOOK_SECRET="your-deepgram-callback-secret"

# ==================================
# OPTIONAL SERVICES
# ==================================

# Email Service (Zoho Mail SMTP)
# Setup: Generate App Password in Zoho Security settings
EMAIL_HOST="smtp.zoho.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@domain.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="Depo-Pro <info@depo-pro.com>"
ADMIN_EMAIL="admin@depo-pro.com"

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cron Security
CRON_SECRET="your-secure-cron-secret-here"

# Redis (BullMQ - Optional)
REDIS_URL=""
REDIS_HOST=""
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ==================================
# APPLICATION SETTINGS
# ==================================

# File Storage
USE_CLOUD_STORAGE="true"
MAX_FILE_SIZE="104857600"  # 100MB in bytes
FILE_RETENTION_DAYS="90"

# Transcription Settings
LOW_CONFIDENCE_THRESHOLD="0.85"
DEEPGRAM_MODEL="nova-3"

# Feature flags
USE_QUEUE="false"
USE_STRIPE="false"
ENABLE_BILLING_PHASE_6="false"
LOG_LEVEL="info"
UPLOADS_DIR="/var/depo-pro/uploads"

# Worker Configuration (BullMQ)
WORKER_CONCURRENCY="3"
WORKER_RATE_LIMIT_MAX="10"
WORKER_RATE_LIMIT_DURATION="1000"

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS="true"
ENABLE_WEBHOOKS="true"

# Google Calendar OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="${NEXT_PUBLIC_SITE_URL}/api/external-calendar/google/callback"

# ==================================
# MONITORING (Optional)
# ==================================

# Sentry Error Tracking
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ==================================
# NOTES
# ==================================

# Get Supabase credentials:
# https://supabase.com/dashboard → Settings → API

# Get Deepgram API key:
# https://console.deepgram.com/ → API Keys

# Vercel Auto-populated:
# VERCEL_URL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA

