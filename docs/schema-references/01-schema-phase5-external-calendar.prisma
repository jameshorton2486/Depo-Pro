// ------------------------------------------------------------
// SYNC HISTORY (Audit trail for sync operations)
// ------------------------------------------------------------

model ExternalCalendarSyncLog {
  id              String                      @id @default(cuid())

  // === CONNECTION ===
  connectionId    String
  connection      ExternalCalendarConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // === SYNC DETAILS ===
  syncType        String                      // "FULL", "INCREMENTAL", "MANUAL"
  status          String                      // "SUCCESS", "PARTIAL", "FAILED"
  
  // Counts
  eventsCreated   Int                         @default(0)
  eventsUpdated   Int                         @default(0)
  eventsDeleted   Int                         @default(0)
  conflictsFound  Int                         @default(0)

  // Timing
  startedAt       DateTime                    @default(now())
  completedAt     DateTime?
  durationMs      Int?

  // Errors
  errorMessage    String?
  errorDetails    Json?

  @@index([connectionId])
  @@index([startedAt])
  @@index([status])

  @@map("external_calendar_sync_logs")
}


