# ═══════════════════════════════════════════════════════════════
# DEPO-PRO ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains secrets!

# ───────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ───────────────────────────────────────────────────────────────
# Get a free PostgreSQL database from:
# - Supabase: https://supabase.com (recommended, includes storage)
# - Neon: https://neon.tech (serverless PostgreSQL)
# - Railway: https://railway.app
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ───────────────────────────────────────────────────────────────
# NEXTAUTH (Authentication)
# ───────────────────────────────────────────────────────────────
# Base URL for your app (use http://localhost:3000 for development)
NEXTAUTH_URL="http://localhost:3000"

# Secret for signing JWT tokens
# Generate with: openssl rand -base64 32
# Or on Windows PowerShell: 
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# ───────────────────────────────────────────────────────────────
# OAUTH PROVIDERS (Phase 2 - Optional)
# ───────────────────────────────────────────────────────────────
# Google OAuth: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth: https://portal.azure.com
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""

# ───────────────────────────────────────────────────────────────
# FILE STORAGE (Phase 2)
# ───────────────────────────────────────────────────────────────
# Set to "true" to use cloud storage, "false" for local storage
USE_CLOUD_STORAGE="false"

# Option 1: Supabase Storage (Recommended if using Supabase DB)
# Get credentials from: https://supabase.com/dashboard
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="depo-files"

# Option 2: AWS S3
# Get credentials from: https://console.aws.amazon.com/iam/
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""

# ───────────────────────────────────────────────────────────────
# DEEPGRAM (Transcription - Phase 2)
# ───────────────────────────────────────────────────────────────
# Set to "true" to use Deepgram API, "false" for mock transcription
USE_DEEPGRAM="false"

# Get API key from: https://console.deepgram.com
# DEEPGRAM_API_KEY="your-api-key-here"

# ───────────────────────────────────────────────────────────────
# EMAIL SERVICE (Phase 2)
# ───────────────────────────────────────────────────────────────
# Set to "true" to use Resend API, "false" for mock emails (console output)
USE_RESEND="false"

# Resend: https://resend.com (recommended)
# RESEND_API_KEY="re_your_api_key_here"
# FROM_EMAIL="noreply@depo-pro.com"

# Alternative: SendGrid
# SENDGRID_API_KEY=""

# ───────────────────────────────────────────────────────────────
# BACKGROUND JOBS (Phase 2 - Optional)
# ───────────────────────────────────────────────────────────────
# Set to "true" to use Redis-backed job queue (BullMQ), "false" for mock in-memory queue
USE_QUEUE="false"

# Redis connection for job queue (required if USE_QUEUE=true)
# Get free Redis from: https://upstash.com or https://redis.com
# REDIS_URL="redis://localhost:6379"

# ───────────────────────────────────────────────────────────────
# PAYMENT PROCESSING (Phase 3)
# ───────────────────────────────────────────────────────────────
# Stripe: https://stripe.com
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ───────────────────────────────────────────────────────────────
# MONITORING & ANALYTICS (Optional)
# ───────────────────────────────────────────────────────────────
# Sentry (error tracking)
# SENTRY_DSN=""

# PostHog (analytics)
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST=""
