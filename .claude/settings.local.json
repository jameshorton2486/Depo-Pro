{
  "permissions": {
    "allow": [
      "Bash(git checkout:*)",
      "Bash(powershell -ExecutionPolicy Bypass -File extract-mega-prompts.ps1:*)",
      "Bash(npx tsc:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(ls:*)",
      "Bash(git rm:*)",
      "Bash(npx supabase:*)",
      "Bash(npm run typecheck:*)",
      "Bash(powershell -Command \"Get-ChildItem -Path app -Include *.ts,*.tsx -Recurse | Where-Object { $_FullName -notmatch ''old-prisma-backup'' } | ForEach-Object { \\(Get-Content $_FullName -Raw\\) -replace ''\\\\.created_by_id'', ''.reporter_id'' | Set-Content $_FullName -NoNewline }\")"
    ]
  }
}
