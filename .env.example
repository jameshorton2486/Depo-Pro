# ===============================================
# DEPO-PRO ENVIRONMENT VARIABLES
# Copy to .env.local and fill in real values.
# Never commit .env.local
# ===============================================

# -- REQUIRED — all 8 must be set in production --
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=https://depo-pro.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEEPGRAM_API_KEY=
USE_DEEPGRAM=true
ANTHROPIC_API_KEY=

# -- EMAIL (Resend) --
RESEND_API_KEY=

# -- WEBHOOKS --
DEEPGRAM_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -- DEPRECATED — DO NOT ADD THESE --
# These were removed during the NextAuth -> Supabase migration.
# NODE_ENV        (Vercel sets this automatically)
# DATABASE_URL    (Prisma — removed)
# DIRECT_URL      (Prisma — removed)
# NEXTAUTH_SECRET (NextAuth — removed)
# NEXTAUTH_URL    (NextAuth — removed)
# ZOHO_SMTP_*     (Zoho SMTP — replaced by Resend)
