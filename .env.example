# =============================================================================
# Depo-Pro Environment Variables
# Canonical reference — see docs/ENVIRONMENT_ARCHITECTURE.md for full details
# =============================================================================
# Copy to .env.local for local development.
# NEVER commit .env.local to git.
# =============================================================================

# =============================================================================
# REQUIRED — App will not start without these
# =============================================================================

# Supabase project URL (find in Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Supabase publishable key (sb_publishable_*) — safe to expose to browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[YOUR-KEY-HERE]"

# Supabase service role key (sb_secret_*) — SERVER ONLY, never expose to browser
SUPABASE_SERVICE_ROLE_KEY="sb_secret_[YOUR-KEY-HERE]"

# Deepgram API key — required for audio transcription
DEEPGRAM_API_KEY="[YOUR-DEEPGRAM-API-KEY]"

# Anthropic API key — required for medical record extraction
ANTHROPIC_API_KEY="[YOUR-ANTHROPIC-API-KEY]"


# =============================================================================
# FEATURE-SPECIFIC — Required when that feature is enabled
# =============================================================================

# App URL — used in email links and transcription scheduler self-calls
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Email — required to send assignment and invoice notifications
EMAIL_HOST="smtp.zoho.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@domain.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="Depo-Pro <info@depo-pro.com>"
ADMIN_EMAIL="admin@depo-pro.com"

# Google Calendar — required for Google Calendar integration
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="${NEXT_PUBLIC_SITE_URL}/api/external-calendar/google/callback"

# Stripe — required when USE_STRIPE=true
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# Redis — required when USE_QUEUE=true (in-memory fallback used otherwise)
REDIS_URL="redis://localhost:6379"


# =============================================================================
# OPTIONAL — Have defaults or gate non-critical features
# =============================================================================

# Security secrets
CRON_SECRET="your-secure-cron-secret-here"
INTERNAL_API_SECRET="your-internal-api-secret-here"
WEBHOOK_SECRET="your-webhook-signing-secret"
DEEPGRAM_WEBHOOK_SECRET="your-deepgram-callback-secret"

# Queue/worker settings (used when USE_QUEUE=true)
USE_QUEUE="false"
WORKER_CONCURRENCY="5"
WORKER_MAX_JOBS_PER_MINUTE="10"

# Feature flags (all default to disabled)
ENABLE_TRANSCRIPTION="true"
ENABLE_MEDICAL_CHRONOLOGY="true"
ENABLE_EXPORT="true"
ENABLE_AI_EXTRACTION="true"
ENABLE_DEMAND_BUILDER="false"
ENABLE_REALTIME="false"
ENABLE_EXHIBITS="false"
ENABLE_VOCABULARY="true"
ENABLE_SHARING="false"
USE_STRIPE="false"
ENABLE_BILLING_PHASE_6="false"

# Runtime tuning
LOG_LEVEL="info"
LOW_CONFIDENCE_THRESHOLD="0.85"
UPLOADS_DIR="./uploads"

# Monitoring
SENTRY_DSN=""


# =============================================================================
# CI-ONLY — Used by GitHub Actions security scripts, NOT by the running app
# =============================================================================
# Do not set these in Vercel. Set them as GitHub repository secrets instead.
# See docs/CI_SECRETS.md for setup instructions.

# Direct PostgreSQL connection — port 5432 (NOT pooler port 6543)
# DIRECT_URL="postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres"

# Supabase CLI authentication (supabase.com → Account → Access Tokens)
# SUPABASE_ACCESS_TOKEN="sbp_[YOUR-ACCESS-TOKEN]"

# Supabase project reference ID
# SUPABASE_PROJECT_ID="ildhcfspbmhuemzgvzyx"

# Supabase database password
# SUPABASE_DB_PASSWORD="[YOUR-DB-PASSWORD]"


# =============================================================================
# TEST-ONLY — Used for local integration testing
# =============================================================================
PLAYWRIGHT_BASE_URL="http://localhost:3000"
TEST_API_URL="http://localhost:3000"
TEST_USER_EMAIL="test@example.com"
TEST_USER_PASSWORD="password"


# =============================================================================
# DEPRECATED — Do not use in new code
# =============================================================================
# DATABASE_URL     → Prisma removed. Use Supabase JS client.
# DIRECT_URL       → App no longer uses direct Postgres. CI scripts only.
# NEXTAUTH_SECRET  → NextAuth removed. Auth handled by Supabase SSR.
# NEXTAUTH_URL     → NextAuth removed.
# NEXT_PUBLIC_SUPABASE_ANON_KEY → Replaced by NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# SUPABASE_URL     → Replaced by NEXT_PUBLIC_SUPABASE_URL
