# =============================================================================
# Depo-Pro — authoritative environment template
# =============================================================================
# Single source of truth for env key names used by this Vite + React app,
# Supabase Edge Functions, the Python formatter, and Cloud Run workers.
#
# Setup:
#   cp .env.example .env
#   Fill in values for the surfaces you are running.
#
# Rules:
#   - Use ONE local file: `.env` (gitignored). Do not create `.env.local`.
#   - Local scripts (`scripts/*.mjs`) load `.env` only.
#   - Vite also loads `.env`; never put secrets in `VITE_*` keys (browser-exposed).
#   - Edge Function / Cloud Run secrets are set in their host secret stores.
#     They are listed here for inventory; leave blank in local `.env` if unused.
#   - This file is committed with blank / placeholder values only.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Frontend (Vite build-time — exposed to the browser)
# Retrieve: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Mock mode is the safe default (0). Set to 1 only when calling real backends.
VITE_USE_REAL_API=0

# Optional override; when true, workspace services use MSW-style mocks.
VITE_USE_MOCKS=false

# In real mode, point at the deployed editor-api Edge Function URL.
VITE_EDITOR_API_BASE_URL=https://your-project-id.supabase.co/functions/v1/editor-api

# Pre-transcription case/audio/keyterm confirmation gate. Set false to bypass.
VITE_REQUIRE_BINDING_CONFIRM=true

# Optional preview-only Deepgram flag. Prefer offline / omit live prod keys.
# VITE_DEEPGRAM_API_KEY is browser-exposed — do not put a production key here.
VITE_TRANSCRIPTION_PROVIDER=offline
# VITE_DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# 2. Supabase server-side (local scripts, Edge Functions, workers)
# Retrieve: Supabase Dashboard → Project Settings → API / Database
# Edge deploy: supabase secrets set KEY=value
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — Postgres connection strings for migration tooling only.
# Not read by application runtime code.
# DATABASE_URL=
# DIRECT_URL=

# -----------------------------------------------------------------------------
# 3. AI providers (server-only)
# Retrieve: https://console.anthropic.com → API Keys
# Used by: ai-review, extract-nod, anthropic-healthcheck, boundary engine,
#          transcript_formatter (Python)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# 4. Deepgram (server-only)
# Retrieve: https://console.deepgram.com → API Keys
# Used by: transcribe-start, transcribe-callback, transcribe-watchdog,
#          transcript_formatter (Python)
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# 5. Edge Function feature flags / config
# Set via: supabase secrets set KEY=value
# -----------------------------------------------------------------------------
# Comma-separated browser origins allowed to call transcribe-start.
TRANSCRIBE_ALLOWED_ORIGINS=http://localhost:5173

# Leave off unless you explicitly want ai-review to auto-apply suggestions.
AI_REVIEW_AUTO_APPLY=false

# -----------------------------------------------------------------------------
# 6. Transcribe watchdog (Edge Function secrets)
# Generate WATCHDOG_SECRET yourself (random string). Tune the numbers as needed.
# -----------------------------------------------------------------------------
WATCHDOG_SECRET=
WATCHDOG_STALE_MINUTES=20
WATCHDOG_FINALIZE_STALE_MINUTES=15
WATCHDOG_MAX_ATTEMPTS=2

# -----------------------------------------------------------------------------
# 7. Cloud Run — transcript finalize worker
# Retrieve: GCP Console (project, Cloud Run URL, Secret Manager)
# Docs: docs/operations/TRANSCRIPT_FINALIZE_WORKER_DEPLOYMENT.md
# -----------------------------------------------------------------------------
PORT=8080
FINALIZE_LEASE_TTL_SECONDS=900
FINALIZE_GCP_PROJECT=
FINALIZE_TASKS_LOCATION=us-central1
FINALIZE_TASKS_QUEUE=depo-pro-transcript-finalize
FINALIZE_WORKER_TASK_URL=
FINALIZE_WORKER_OIDC_AUDIENCE=
FINALIZE_GCP_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# 8. Export adapter / formatter (Edge + Cloud Run)
# Retrieve: GCP Console (project, Cloud Tasks, Cloud Run, GCS bucket, SA JSON)
# Docs: docs/operations/EXPORT_ADAPTER_DEPLOYMENT.md
#       docs/operations/FORMATTER_SERVICE_DEPLOYMENT.md
# -----------------------------------------------------------------------------
EXPORT_GCP_PROJECT=
EXPORT_TASKS_LOCATION=us-central1
EXPORT_TASKS_QUEUE=depo-pro-formatter
EXPORT_ARTIFACT_BUCKET=
EXPORT_ARTIFACT_URL_TTL_SECONDS=900
EXPORT_ADAPTER_RELAY_URL=
EXPORT_ADAPTER_RELAY_OIDC_AUDIENCE=
EXPORT_FORMATTER_TASK_URL=
EXPORT_FORMATTER_OIDC_AUDIENCE=
EXPORT_GCP_SERVICE_ACCOUNT_JSON=
FORMATTER_VERSION=

# -----------------------------------------------------------------------------
# 9. Local smoke / seed / test harness (optional — scripts & vitest only)
# Create disposable Auth users in a non-production Supabase project.
# -----------------------------------------------------------------------------
# SMOKE_USER_EMAIL=
# SMOKE_USER_PASSWORD=
# SMOKE_USER2_EMAIL=
# SMOKE_USER2_PASSWORD=
# EDITOR_API_BASE_URL=
# EDITOR_API_SEED_PATH=
# SEED_OWNER_USER_ID=
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=
# Set to 1 only when intentionally writing Stage S audit artifacts during tests.
# STAGE_S_WRITE=0

# -----------------------------------------------------------------------------
# 10. Stale / unused — DO NOT ADD (not referenced by current codebase)
# Leftovers from Next.js / Stripe / Vercel templates. Safe to delete if present.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# NEXT_PUBLIC_APP_URL
# NEXT_PUBLIC_SITE_URL
# OPENAI_API_KEY
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# USE_STRIPE
# ENABLE_BILLING_PHASE_6
# RESEND_API_KEY
# CRON_SECRET
# INTERNAL_API_SECRET
# WEBHOOK_SECRET
# ADMIN_EMAIL
# LOW_CONFIDENCE_THRESHOLD
# USE_DEEPGRAM
# DEEPGRAM_WEBHOOK_SECRET
# VERCEL_OIDC_TOKEN
# SUPABASE_SECRET_KEY
# VITE_SUPABASE_PUBLISHABLE_KEY
# AI_REVIEW_BRIDGE
# TIE_MODEL_OPUS / TIE_MODEL_SONNET / TIE_MODEL_HAIKU
