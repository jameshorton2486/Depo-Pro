VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Commercial test environment (server-side Edge Function secrets). Never put
# live Stripe or Deepgram credentials in VITE_* variables.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEEPGRAM_API_KEY=
LICENSING_MONTHLY_PRICE_CENTS=4900
LICENSING_INCLUDED_SECONDS=108000
LICENSING_GRACE_DAYS=5
LICENSING_ALLOWED_ORIGINS=http://localhost:5173
LICENSING_PUBLIC_APP_URL=http://localhost:5173
VITE_USE_REAL_API=0
# In real mode, the host config's apiBaseUrl should point at your deployed editor-api Edge Function URL.
VITE_EDITOR_API_BASE_URL=https://your-project-id.supabase.co/functions/v1/editor-api
