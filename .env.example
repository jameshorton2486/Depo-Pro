# =============================================================================
# DEPO-PRO — ENVIRONMENT VARIABLES
# =============================================================================
#
# INSTRUCTIONS
#   Local dev:   Copy this file to .env.local and fill in real values.
#                Never commit .env.local to git.
#   Production:  Set all REQUIRED variables in Vercel → Settings →
#                Environment Variables for the Production environment.
#   Preview:     Set all REQUIRED variables for the Preview environment.
#                Use test/sandbox API keys where available.
#
# LABELS
#   [REQUIRED]    — App throws on startup if missing (lib/env.ts + lib/config/env.ts)
#   [CONDITIONAL] — Required only when the feature is enabled
#   [OPTIONAL]    — Has a safe fallback; app degrades gracefully if missing
#
# Generated from codebase scan of every process.env reference.
# Last verified: 2026-03-15
# =============================================================================


# =============================================================================
# SUPABASE
# Dashboard : https://supabase.com/dashboard/project/ildhcfspbmhuemzgvzyx
# Settings  : Project Settings → API
# =============================================================================

# [REQUIRED] Your Supabase project URL — same across all environments
NEXT_PUBLIC_SUPABASE_URL=https://ildhcfspbmhuemzgvzyx.supabase.co

# [REQUIRED] Publishable (anon) key — safe to expose to the browser
# Format: sb_publishable_... (new format) — validated in lib/supabase/browser.ts
# Copy from: Project Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# [REQUIRED] Service role key — server-side only, never expose to browser
# Copy from: Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=sb_secret_placeholder


# =============================================================================
# DEEPGRAM — Speech-to-text transcription
# Dashboard : https://console.deepgram.com
# =============================================================================

# [REQUIRED] Deepgram API key — used by lib/deepgram/client.ts, lib/transcription.ts
# Copy from: console.deepgram.com → API Keys → Create a New API Key
DEEPGRAM_API_KEY=REPLACE_ME

# [CONDITIONAL] Secret for verifying Deepgram webhook signatures
# Used in: app/api/webhooks/[provider]/route.ts
# Generate with: openssl rand -hex 32
# Must match the secret configured in Deepgram Dashboard → Webhooks
DEEPGRAM_WEBHOOK_SECRET=


# =============================================================================
# ANTHROPIC — AI medical record extraction
# Dashboard : https://console.anthropic.com
# =============================================================================

# [REQUIRED] Anthropic API key — used for medical chronology + AI corrections
# Used in: lib/ai/correctionWorker.ts, lib/services/medical-extraction.ts
# Copy from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME


# =============================================================================
# RESEND — Transactional email
# Dashboard : https://resend.com/api-keys
# From addr : Depo-Pro <notifications@depo-pro.com>
# CLI helper: node scripts/resend-cli.mjs help
# =============================================================================

# [CONDITIONAL] Resend API key — used for password reset, job notifications, invoices
# Used in: lib/email.ts
# Copy from: resend.com → API Keys → Create API Key
RESEND_API_KEY=re_REPLACE_ME

# [OPTIONAL] Admin notification recipient — fallback: info@depo-pro.com
# Used in: lib/email.ts
ADMIN_EMAIL=


# =============================================================================
# STRIPE — Billing and subscriptions
# Dashboard : https://dashboard.stripe.com
# Webhooks  : https://dashboard.stripe.com/webhooks
#
# IMPORTANT: Keys must match — do not mix live and test keys.
#   Development / Preview → use sk_test_ and whsec_test_ keys
#   Production            → use sk_live_ and whsec_ keys
# =============================================================================

# [CONDITIONAL] Stripe secret key — server-side only
# Used in: app/api/webhooks/stripe/route.ts, lib/invoice.ts
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# [CONDITIONAL] Webhook signing secret — verify events from Stripe
# Copy from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# [OPTIONAL] Set to "true" to activate Stripe billing — default: false
# Used in: lib/invoice.ts
USE_STRIPE=false


# =============================================================================
# GOOGLE CALENDAR — External calendar sync (future feature)
# Console   : https://console.cloud.google.com/apis/credentials
# =============================================================================

# [CONDITIONAL] Required only when Google Calendar integration is enabled
# Used in: lib/google.ts, lib/external-calendar/google-provider.ts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [OPTIONAL] Defaults to {NEXT_PUBLIC_SITE_URL}/api/external-calendar/google/callback
GOOGLE_REDIRECT_URI=


# =============================================================================
# REDIS — Job queue (BullMQ)
# =============================================================================

# [OPTIONAL] Redis connection URL — used for background job queue
# Used in: lib/jobs.ts, lib/queue/connection.ts, lib/deepgram/index.ts
# Without this, jobs run synchronously (acceptable for local dev)
REDIS_URL=

# [OPTIONAL] Set to "true" to use BullMQ queue — default: false (sync mode)
# Used in: lib/jobs.ts
USE_QUEUE=false


# =============================================================================
# APPLICATION
# =============================================================================

# [OPTIONAL] Canonical public URL — used in email links, internal API calls
# Used in: app/api/jobs/[id]/transcribe/resume, process-chunk
# Fallback: NEXT_PUBLIC_SITE_URL, then https://depo-pro.com
# Production: https://depo-pro.com   Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPTIONAL] Used for Supabase auth redirects and email link URLs
# Used in: proxy.ts, lib/email.ts, lib/external-calendar/google-provider.ts
# Fallback: request origin or https://depo-pro.com
# Must match Supabase → Authentication → URL Configuration → Site URL
# Production: https://depo-pro.com   Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://depo-pro.com

# [CONDITIONAL] Protects /api/cron/* endpoints from unauthorized calls
# Used in: app/api/cron/process-jobs, app/api/cron/cleanup
# Also used as fallback for INTERNAL_API_SECRET in transcription scheduler
# Generate with: openssl rand -hex 32
CRON_SECRET=

# [OPTIONAL] Secret for internal API-to-API calls (transcription chunking)
# Used in: app/api/jobs/[id]/transcribe/process-chunk/route.ts
# Fallback: CRON_SECRET
INTERNAL_API_SECRET=

# [OPTIONAL] Webhook signing secret for outbound webhooks
# Used in: lib/webhooks/sign.ts
# Fallback: 'webhook-secret-change-in-production'
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# [OPTIONAL] URL to POST contact form submissions (Slack, Discord, etc.)
# Used in: app/api/contact/route.ts — skipped if unset
CONTACT_WEBHOOK_URL=

# [OPTIONAL] Log verbosity: debug | info | warn | error
# Used in: lib/logger.ts — default: info (production) or debug (development)
LOG_LEVEL=

# [OPTIONAL] Local file upload directory — default: ./uploads
# Used in: lib/storage.ts (local dev fallback when Supabase Storage unavailable)
UPLOADS_DIR=

# [OPTIONAL] Confidence threshold for flagging low-quality words — default: 0.85
# Used in: lib/transcription/quality-checker.ts
LOW_CONFIDENCE_THRESHOLD=


# =============================================================================
# FEATURE FLAGS — Kill switches (no redeploy needed)
# See lib/config/features.ts for full documentation
# =============================================================================

# All default to ENABLED (set to "false" to disable):
# ENABLE_MEDICAL_CHRONOLOGY=true
# ENABLE_EXPORT=true
# ENABLE_AI_EXTRACTION=true
# ENABLE_TRANSCRIPTION=true
# ENABLE_EXHIBITS=true
# ENABLE_VOCABULARY=true
# ENABLE_SHARING=true

# These default to DISABLED (set to "true" to enable):
# ENABLE_DEMAND_BUILDER=false
# ENABLE_REALTIME=false
# ENABLE_BILLING_PHASE_6=false

# Pre-beta mode hides unfinished pages from nav (set to "true" to show all):
# DISABLE_PRE_BETA=false


# =============================================================================
# DEPRECATED — DO NOT USE
# =============================================================================
# These variables are NOT referenced anywhere in the codebase.
# Do not set them in Vercel or .env.local.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY     Replaced by NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY  Not referenced in any source file
# UPSTASH_REDIS_REST_URL            Not used — code uses REDIS_URL instead
# UPSTASH_REDIS_REST_TOKEN          Not used — code uses REDIS_URL instead
# USE_DEEPGRAM                      Only in types/env.d.ts, never read at runtime
# DATABASE_URL                      Prisma removed — Supabase handles DB directly
# DIRECT_URL                        Prisma removed
# NEXTAUTH_SECRET                   NextAuth removed — Supabase Auth only
# NEXTAUTH_URL                      NextAuth removed
# SMTP_*                            Replaced by RESEND_API_KEY
# NODE_ENV                          Set automatically by Vercel / Next.js
# VERCEL_ENV                        Set automatically by Vercel
# NEXT_PHASE                        Set automatically by Next.js build
# =============================================================================
