# Database
# Direct connection to Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Connect to Supabase via Shared Connection Pooler (for production)
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database through Shared Pooler (supports IPv4/IPv6). Used for migrations.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# App URL
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Deepgram
DEEPGRAM_API_KEY="[YOUR-DEEPGRAM-API-KEY]"
USE_DEEPGRAM="true"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[YOUR-KEY-HERE]"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_[YOUR-KEY-HERE]"
# Optional legacy/script support
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_anon_[YOUR-KEY-HERE]"

# Redis (if using queues/BullMQ)
REDIS_URL="redis://localhost:6379"

# Vercel Blob Storage (if using)
# BLOB_READ_WRITE_TOKEN="[YOUR-BLOB-TOKEN]"

# Email Service


# Email Service (Zoho Mail SMTP)
# Setup: Generate App Password in Zoho Security settings
EMAIL_HOST="smtp.zoho.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@domain.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="Depo-Pro <info@depo-pro.com>"
ADMIN_EMAIL="admin@depo-pro.com"


# Cron Security
CRON_SECRET=your-secure-cron-secret-here

# Webhook Secrets
WEBHOOK_SECRET=your-webhook-signing-secret
DEEPGRAM_WEBHOOK_SECRET=your-deepgram-callback-secret

# Optional: Stripe (for future billing)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Google Calendar OAuth (Phase 5)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=${NEXT_PUBLIC_SITE_URL}/api/external-calendar/google/callback

# Feature flags / runtime configuration
USE_QUEUE="false"
USE_STRIPE="false"
ENABLE_BILLING_PHASE_6="false"
LOW_CONFIDENCE_THRESHOLD="0.85"
LOG_LEVEL="info"
UPLOADS_DIR="./uploads"
WORKER_CONCURRENCY="5"
WORKER_MAX_JOBS_PER_MINUTE="10"

# Monitoring (optional)
SENTRY_DSN=""

# Testing / CI (optional)
PLAYWRIGHT_BASE_URL="http://localhost:3000"
TEST_API_URL="http://localhost:3000"
TEST_USER_EMAIL="test@example.com"
TEST_USER_PASSWORD="password"
CI="false"
NEXT_PHASE="phase-development-server"


