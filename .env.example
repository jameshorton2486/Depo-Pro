# =============================================================================
# Depo-Pro Environment Variables
# =============================================================================

# App URL
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# =============================================================================
# Required - Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[YOUR-KEY-HERE]"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_[YOUR-KEY-HERE]"

# Optional legacy/script compatibility
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_anon_[YOUR-KEY-HERE]"

# =============================================================================
# Required - Core services
# =============================================================================
DEEPGRAM_API_KEY="[YOUR-DEEPGRAM-API-KEY]"
ANTHROPIC_API_KEY="[YOUR-ANTHROPIC-API-KEY]"

# =============================================================================
# Optional - Queue/infra
# =============================================================================
REDIS_URL="redis://localhost:6379"
USE_QUEUE="false"
WORKER_CONCURRENCY="5"
WORKER_MAX_JOBS_PER_MINUTE="10"

# =============================================================================
# Optional - Email (Zoho SMTP)
# =============================================================================
ZOHO_SMTP_HOST="smtp.zoho.com"
ZOHO_SMTP_PORT="587"
ZOHO_SMTP_USER="your-email@domain.com"
ZOHO_SMTP_PASS="your-app-password"
EMAIL_FROM="Depo-Pro <info@depo-pro.com>"
ADMIN_EMAIL="admin@depo-pro.com"

# =============================================================================
# Optional - Webhooks/Cron/Billing
# =============================================================================
CRON_SECRET="your-secure-cron-secret-here"
WEBHOOK_SECRET="your-webhook-signing-secret"
DEEPGRAM_WEBHOOK_SECRET="your-deepgram-callback-secret"
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# Optional - Google Calendar
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="${NEXT_PUBLIC_SITE_URL}/api/external-calendar/google/callback"

# =============================================================================
# Optional - Feature flags/runtime
# =============================================================================
USE_STRIPE="false"
ENABLE_BILLING_PHASE_6="false"
LOW_CONFIDENCE_THRESHOLD="0.85"
LOG_LEVEL="info"
UPLOADS_DIR="./uploads"

# =============================================================================
# Optional - Monitoring/Test
# =============================================================================
SENTRY_DSN=""
PLAYWRIGHT_BASE_URL="http://localhost:3000"
TEST_API_URL="http://localhost:3000"
TEST_USER_EMAIL="test@example.com"
TEST_USER_PASSWORD="password"
CI="false"

# =============================================================================
# Deprecated (do not use)
# DATABASE_URL
# DIRECT_URL
# NEXTAUTH_SECRET
# NEXTAUTH_URL
# =============================================================================
