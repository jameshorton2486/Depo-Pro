# Database
# Direct connection to Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Connect to Supabase via Shared Connection Pooler (for production)
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database through Shared Pooler (supports IPv4/IPv6). Used for migrations.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Auth (NextAuth)
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="[GENERATE-A-SECURE-RANDOM-STRING]"

# Deepgram
DEEPGRAM_API_KEY="[YOUR-DEEPGRAM-API-KEY]"
USE_DEEPGRAM="true"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"

# Redis (if using BullMQ)
# REDIS_HOST="localhost"
# REDIS_PORT="6379"

# Vercel Blob Storage (if using)
# BLOB_READ_WRITE_TOKEN="[YOUR-BLOB-TOKEN]"

# Email (if using)
# RESEND_API_KEY="[YOUR-RESEND-KEY]"
# SENDGRID_WEBHOOK_SECRET="[YOUR-SENDGRID-SECRET]"

# App URL
APP_URL="https://your-app.vercel.app"
