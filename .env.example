# ===============================================
# DEPO-PRO ENVIRONMENT VARIABLES
# Copy to .env.local and fill in real values.
# Never commit .env.local
# ===============================================

# -- Supabase (REQUIRED) --
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -- Deepgram (REQUIRED) --
DEEPGRAM_API_KEY=
USE_DEEPGRAM=true
DEEPGRAM_WEBHOOK_SECRET=

# -- Anthropic (REQUIRED) --
ANTHROPIC_API_KEY=

# -- Resend Email (REQUIRED) --
RESEND_API_KEY=

# -- Stripe (required when billing launches) --
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -- Upstash Redis (optional — falls back to in-memory) --
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -- App Config --
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=https://depo-pro.com
CRON_SECRET=

# -- DEPRECATED — DO NOT ADD THESE --
# NODE_ENV        (Vercel sets automatically)
# DATABASE_URL    (Prisma removed)
# DIRECT_URL      (Prisma removed)
# NEXTAUTH_SECRET (NextAuth removed)
# NEXTAUTH_URL    (NextAuth removed)
# ZOHO_SMTP_*     (replaced by Resend)
