# .env.example
# Copy this to .env.local and fill in your values

# ===========================================
# DATABASE (Supabase PostgreSQL)
# ===========================================
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ===========================================
# AUTHENTICATION (NextAuth.js)
# ===========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# ===========================================
# DEEPGRAM (AI Transcription)
# ===========================================
DEEPGRAM_API_KEY="your-deepgram-api-key"

# ===========================================
# SUPABASE (Storage & Auth)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ===========================================
# REDIS (Background Jobs - Upstash)
# ===========================================
REDIS_URL="redis://default:[PASSWORD]@[HOST].upstash.io:6379"
# Or use these separately:
UPSTASH_REDIS_REST_URL="https://[HOST].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ===========================================
# FILE STORAGE
# ===========================================
UPLOADS_DIR="./uploads"
# For production, use Supabase Storage:
STORAGE_BUCKET="depo-pro-files"

# ===========================================
# EMAIL (Optional - for notifications)
# ===========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="Depo-Pro <noreply@your-domain.com>"

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV="development"
# Set to "production" in Vercel
