echo "🔍 Running pre-commit checks..."

# Scan staged files for secrets
echo "🔐 Running secret scan..."
npm run security:scan:staged || {
  echo "❌ Secret scan failed. Remove hardcoded credentials before committing."
  exit 1
}

# Run linting
echo "📝 Running ESLint..."
npm run lint || {
  echo "❌ ESLint failed. Fix errors or use --no-verify to skip."
  exit 1
}

# Run type checking
echo "🔷 Running TypeScript type check..."
npm run typecheck || {
  echo "❌ TypeScript check failed. Fix errors or use --no-verify to skip."
  exit 1
}

echo "✅ Pre-commit checks passed!"
exit 0
