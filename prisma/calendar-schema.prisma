// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum CalendarEventStatus {
  REQUESTED      // Attorney submitted request, awaiting agency action
  SCHEDULED      // Agency created/confirmed the event
  CONFIRMED      // Reporter accepted the assignment
  IN_PROGRESS    // Deposition is currently happening
  COMPLETED      // Deposition finished, ready for transcription
  CANCELLED      // Event was cancelled (see cancellationReason)
  RESCHEDULED    // Moved to a new time (original event archived)
}

enum EventType {
  DEPOSITION           // Standard deposition
  HEARING              // Court hearing
  ARBITRATION          // Arbitration proceeding
  MEDIATION            // Mediation session
  EUO                  // Examination Under Oath
  STATEMENT            // Recorded statement
  OTHER                // Other legal proceeding
}

enum AvailabilityType {
  AVAILABLE            // Reporter is available
  UNAVAILABLE          // Reporter is blocked (vacation, etc.)
  TENTATIVE            // Possibly available, needs confirmation
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// ------------------------------------------------------------
// CALENDAR EVENT (Core scheduling model)
// ------------------------------------------------------------

model CalendarEvent {
  id                String              @id @default(cuid())
  
  // === MULTI-TENANT ===
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // === EVENT DETAILS ===
  title             String              // e.g., "Smith v. Jones Deposition"
  eventType         EventType           @default(DEPOSITION)
  status            CalendarEventStatus @default(REQUESTED)
  
  // === TIMING (All times stored as UTC) ===
  startTime         DateTime
  endTime           DateTime
  timezone          String              @default("America/Chicago") // IANA timezone
  allDay            Boolean             @default(false)
  
  // === RECURRENCE (Optional) ===
  isRecurring       Boolean             @default(false)
  recurrenceRule    String?             // RRULE format: "FREQ=WEEKLY;BYDAY=MO,WE,FR"
  recurrenceEndDate DateTime?
  parentEventId     String?             // For recurring instances, points to parent
  parentEvent       CalendarEvent?      @relation("RecurringEvents", fields: [parentEventId], references: [id])
  childEvents       CalendarEvent[]     @relation("RecurringEvents")
  
  // === LOCATION ===
  location          String?             // Physical address or "Remote"
  isRemote          Boolean             @default(false)
  meetingLink       String?             // Zoom/Teams link if remote
  
  // === RELATIONSHIPS ===
  // Link to Job (for transcription workflow)
  jobId             String?             @unique
  job               Job?                @relation(fields: [jobId], references: [id])
  
  // Assigned court reporter
  assignedReporterId String?
  assignedReporter   User?              @relation("ReporterAssignments", fields: [assignedReporterId], references: [id])
  
  // Attorney who requested (for REQUESTED status)
  requestedById     String?
  requestedBy       User?               @relation("AttorneyRequests", fields: [requestedById], references: [id])
  
  // Agency user who scheduled/approved
  scheduledById     String?
  scheduledBy       User?               @relation("AgencyScheduled", fields: [scheduledById], references: [id])
  
  // Participants (attorneys, witnesses, etc.)
  participants      EventParticipant[]
  
  // === METADATA ===
  notes             String?             @db.Text
  internalNotes     String?             @db.Text  // Agency-only notes
  cancellationReason String?
  
  // === AUDIT ===
  createdById       String
  createdBy         User                @relation("EventCreator", fields: [createdById], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  confirmedAt       DateTime?           // When reporter confirmed
  cancelledAt       DateTime?
  
  // === INDEXES for fast queries ===
  @@index([organizationId, startTime, endTime])  // Conflict detection
  @@index([assignedReporterId, startTime])        // Reporter schedule
  @@index([status])                               // Status filtering
  @@index([jobId])                                // Job lookup
  
  @@map("calendar_events")
}

// ------------------------------------------------------------
// EVENT PARTICIPANTS (Attorneys, witnesses, interpreters, etc.)
// ------------------------------------------------------------

model EventParticipant {
  id              String          @id @default(cuid())
  
  eventId         String
  event           CalendarEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Can be a system user OR external person
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  
  // For external participants (not in system)
  externalName    String?
  externalEmail   String?
  externalPhone   String?
  
  // Role in the event
  role            ParticipantRole
  
  // Status
  notified        Boolean         @default(false)
  notifiedAt      DateTime?
  confirmed       Boolean         @default(false)
  confirmedAt     DateTime?
  
  createdAt       DateTime        @default(now())
  
  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_participants")
}

enum ParticipantRole {
  ATTORNEY_PLAINTIFF
  ATTORNEY_DEFENSE
  WITNESS
  DEPONENT
  INTERPRETER
  VIDEOGRAPHER
  OBSERVER
}

// ------------------------------------------------------------
// REPORTER AVAILABILITY (For scheduling optimization)
// ------------------------------------------------------------

model ReporterAvailability {
  id              String            @id @default(cuid())
  
  // Which reporter
  reporterId      String
  reporter        User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  
  // Organization context
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Time block
  startTime       DateTime
  endTime         DateTime
  timezone        String            @default("America/Chicago")
  
  // Type of availability
  type            AvailabilityType  @default(AVAILABLE)
  
  // Recurrence for regular schedules
  isRecurring     Boolean           @default(false)
  recurrenceRule  String?           // "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR"
  recurrenceEnd   DateTime?
  
  // Notes
  notes           String?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@index([reporterId, startTime, endTime])
  @@index([organizationId, type])
  @@map("reporter_availability")
}

// ------------------------------------------------------------
// BOOKING REQUEST (Attorney → Agency workflow)
// ------------------------------------------------------------

model BookingRequest {
  id              String              @id @default(cuid())
  
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Requesting attorney
  requestedById   String
  requestedBy     User                @relation(fields: [requestedById], references: [id])
  
  // Request details
  caseName        String
  caseNumber      String?
  preferredDate   DateTime
  alternateDate1  DateTime?
  alternateDate2  DateTime?
  estimatedDuration Int               @default(240)  // Minutes
  
  eventType       EventType           @default(DEPOSITION)
  location        String?
  isRemote        Boolean             @default(false)
  
  // Deponent info
  deponentName    String
  deponentContact String?
  
  // Special requirements
  needsInterpreter Boolean            @default(false)
  interpreterLanguage String?
  needsVideographer Boolean           @default(false)
  needsRealtime   Boolean             @default(false)  // Realtime transcription
  specialNotes    String?             @db.Text
  
  // Status
  status          BookingRequestStatus @default(PENDING)
  
  // If approved, link to created event
  calendarEventId String?             @unique
  calendarEvent   CalendarEvent?      @relation(fields: [calendarEventId], references: [id])
  
  // Agency response
  respondedById   String?
  respondedBy     User?               @relation("AgencyResponder", fields: [respondedById], references: [id])
  respondedAt     DateTime?
  rejectionReason String?
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  @@index([organizationId, status])
  @@index([requestedById])
  @@map("booking_requests")
}

enum BookingRequestStatus {
  PENDING         // Awaiting agency review
  APPROVED        // Approved, event created
  REJECTED        // Rejected by agency
  CANCELLED       // Cancelled by attorney
  MODIFIED        // Agency proposed different time
}

