// Pricing Snapshot (per Authoritative Build Spec)
// IMMUTABLE record of pricing at job creation time
// Ensures invoices are never affected by rate changes
model PricingSnapshot {
  id String @id @default(cuid())

  // Core transcription pricing
  transcriptionRateCents Int // $1.60/min = 160 cents
  asrMultiplier          Float @default(1.0) // 1.25× for enhanced

  // Human review pricing
  confidenceReviewRateCents Int // $0.35/1000 words = 35 cents per 1000
  fullReviewRateCents       Int // $1.25/min = 125 cents

  // Premium services
  rxFlatFeeCents Int // $150 flat = 15000 cents

  // Minimums
  minTranscriptionMinutes Int @default(15) // 15-min minimum

  // Metadata
  createdAt DateTime @default(now())

  // Relations
  jobs Job[] @relation("JobPricingSnapshot")

  @@index([createdAt])
}

