// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          UserRole
  
  // Profile
  firstName     String
  lastName      String
  phone         String?
  photo         String?   // URL to Supabase Storage
  timezone      String    @default("America/New_York")
  
  // Reporter-specific
  agencyName    String?
  csrNumber     String?   // Certified Shorthand Reporter number
  
  // Scopist-specific
  specialties   String[]  // ["medical", "technical", "legal"]
  experienceLevel String? // "beginner", "intermediate", "expert"
  availability  Boolean   @default(true)
  
  // Settings
  defaultTranscriptSettings Json?
  notificationPreferences   Json?
  
  // Relationships
  jobsCreated       Job[]           @relation("CreatedBy")
  casesCreated      Case[]          @relation("CaseCreator")
  assignments       JobAssignment[]
  messages          Message[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  @@index([email])
  @@index([role])
}

enum UserRole {
  REPORTER
  SCOPIST
  ADMIN
}

// ============================================
// JOB MODELS
// ============================================

model Job {
  id              String      @id @default(cuid())
  
  // Basic Info
  title           String
  caseName        String
  caseNumber      String?
  depositionDate  DateTime
  location        String?     // Physical address or "Zoom"
  zoomLink        String?
  
  // Status
  status          JobStatus   @default(CREATED)
  
  // Firm association (optional for now)
  firmId          String?
  firm            Firm?       @relation(fields: [firmId], references: [id])

  // Assignment
  createdById     String
  createdBy       User        @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId    String?     // If self-edit, same as createdById
  
  // Case association
  caseId          String?
  case            Case?         @relation(fields: [caseId], references: [id])
  
  // Files
  files           JobFile[]
  exhibits        Exhibit[]
  
  // Transcription
  transcriptionJobs         TranscriptionJob[]
  transcription             Transcription?
  transcripts               Transcript[]
  transcriptionModelType    String?  @default("MEDICAL")  // STANDARD, MEDICAL, BILINGUAL
  transcriptionCompletedAt  DateTime?
  errorMessage              String?
  
  // Communication
  messages        Message[]
  assignments     JobAssignment[]
  
  // Metadata
  notes           String?     @db.Text
  internalNotes   String?     @db.Text // Private notes not visible to scopist
  
  // Lock system
  lockedBy        String?
  lockedAt        DateTime?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?
  
  @@index([createdById])
  @@index([firmId])
  @@index([caseId])
  @@index([status])
  @@index([depositionDate])
}

enum JobStatus {
  CREATED
  FILES_UPLOADED
  ENHANCING_AUDIO
  TRANSCRIBING
  AI_REVIEWING
  READY_FOR_EDIT
  ASSIGNED
  IN_EDIT
  SUBMITTED_FOR_REVIEW
  IN_REVIEW
  COMPLETED
  CANCELLED
}

model JobFile {
  id          String      @id @default(cuid())
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  type        FileType
  fileName    String
  fileSize    Int         // bytes
  mimeType    String
  
  // Storage
  storageUrl  String      // Supabase Storage URL
  storagePath String      // Path in bucket
  
  // For extracted data (Notice, Court Order)
  extractedData Json?
  
  createdAt   DateTime    @default(now())
  
  @@index([jobId, type])
}

// ============================================
// EXHIBITS
// ============================================

model Exhibit {
  id              String   @id @default(cuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  exhibitNumber   Int
  description     String
  
  originalFileUrl String
  stampedFileUrl  String?
  
  fileType        String   // PDF, IMAGE, DOCX
  mimeType        String
  fileName        String
  fileSize        Int      // bytes
  
  stamped         Boolean  @default(false)
  
  createdById     String
  createdAt       DateTime @default(now())
  
  @@unique([jobId, exhibitNumber])
  @@index([jobId])
}

enum FileType {
  AUDIO
  VIDEO
  NOTICE
  COURT_ORDER
  ROUGH_TRANSCRIPT
  EXHIBIT
  FINAL_TRANSCRIPT
}

// ============================================
// AUDIO ENHANCEMENT
// ============================================

model AudioEnhancement {
  id                  String    @id @default(cuid())
  jobId               String
  
  // Input
  originalAudioUrl    String
  originalDuration    Float     // seconds
  originalFileSize    Int       // bytes
  
  // Enhancement
  enhancementMode     EnhancementMode
  dolbyProcessed      Boolean   @default(false)
  dolbyAudioUrl       String?
  dolbyQualityScore   Float?    // 0-100
  
  auphonicProcessed   Boolean   @default(false)
  auphonicAudioUrl    String?
  auphonicQualityScore Float?
  
  finalAudioUrl       String    // The one sent to Deepgram
  engineUsed          String    // "dolby", "auphonic", or "none"
  
  // Cost tracking
  dolbyCostCents      Int?
  auphonicCostCents   Int?
  totalCostCents      Int
  
  // Metadata
  qualityFlags        Json?     // {"noise": "high", "clipping": "low"}
  decisionReason      String?   // Why Auphonic was/wasn't used
  
  status              EnhancementStatus @default(PENDING)
  errorMessage        String?
  
  createdAt           DateTime  @default(now())
  completedAt         DateTime?
  
  @@index([jobId])
}

enum EnhancementMode {
  OFF
  DOLBY_ONLY
  HYBRID
  AUPHONIC_ONLY
}

enum EnhancementStatus {
  PENDING
  PROCESSING_DOLBY
  PROCESSING_AUPHONIC
  COMPLETED
  ERROR
}

// ============================================
// TRANSCRIPTION
// ============================================

model TranscriptionJob {
  id                  String      @id @default(cuid())
  jobId               String
  job                 Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // Deepgram
  deepgramRequestId   String      @unique
  audioUrl            String      // Enhanced audio URL
  
  // Configuration
  config              Json        // Deepgram options used
  
  // Status
  status              TranscriptionStatus @default(PENDING)
  
  // Results
  rawJson             Json?       // Full Deepgram response
  duration            Float?      // Audio duration
  wordCount           Int?
  averageConfidence   Float?
  speakerCount        Int?
  
  // Error handling
  errorMessage        String?
  retryCount          Int         @default(0)
  maxRetries          Int         @default(3)
  
  createdAt           DateTime    @default(now())
  completedAt         DateTime?
  
  @@index([jobId])
  @@index([status])
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
  CANCELLED
}

model Transcript {
  id                String      @id @default(cuid())
  jobId             String
  job               Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // Version
  version           String      // "1.0-raw", "2.0-ai-reviewed", "3.0-scopist", "4.0-final"
  versionNumber     Int         // 1, 2, 3, 4
  
  // Content
  content           String      @db.Text  // Plain text
  contentJson       Json        // TipTap JSON document
  
  // Tokens (for audio sync)
  tokens            TranscriptToken[]
  
  // Metadata
  wordCount         Int?
  pageCount         Int?
  averageConfidence Float?
  speakerCount      Int?
  
  // AI Review (for version 2.0)
  aiChanges         Json?       // List of changes made
  aiFlags           Json?       // Low-confidence sections
  
  // Creator
  createdBy         String      // "system", userId
  
  createdAt         DateTime    @default(now())
  
  @@unique([jobId, version])
  @@index([jobId, versionNumber])
}

model TranscriptToken {
  id            String      @id @default(cuid())
  transcriptId  String
  transcript    Transcript  @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  
  // Position in transcript
  index         Int         // Word index in document
  
  // Content
  word          String
  punctuatedWord String?    // With punctuation
  
  // Timing
  start         Float       // seconds
  end           Float       // seconds
  
  // Quality
  confidence    Float       // 0.0 - 1.0
  isFlagged     Boolean     @default(false)  // confidence < 0.80
  isReviewed    Boolean     @default(false)  // User marked as reviewed
  
  // Speaker
  speaker       Int?        // Speaker ID from diarization
  
  createdAt     DateTime    @default(now())
  
  @@index([transcriptId, index])
  @@index([transcriptId, isFlagged])
}

model Transcription {
  id                  String      @id @default(cuid())
  jobId               String      @unique
  job                 Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Core transcript data
  fullTranscript      String      @db.Text
  deepgramRawJson     String?     @db.Text  // Full Deepgram response
  
  // Structured data (JSON strings)
  words               Json                  // Word-level data with timestamps
  utterances          Json?                 // Speaker turns
  flaggedSegments     Json?                 // Low-confidence words
  speakerAnalysis     Json?                 // AI speaker identification
  speakerAssignments  Json?                 // User-defined speaker mapping
  
  // Metadata
  duration            Float?                // Audio duration in seconds
  wordCount           Int?
  flaggedWordCount    Int?
  averageConfidence   Float?
  speakerCount        Int         @default(0)
  modelUsed           String?               // STANDARD, MEDICAL, BILINGUAL
  
  // Status
  status              TranscriptionStatus @default(PENDING)
  
  // Versioning
  version             Int         @default(1)
  
  // Relations
  edits               TranscriptionEdit[]

  // Timestamps
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([jobId])
}

model TranscriptionEdit {
  id                String      @id @default(cuid())
  transcriptionId   String
  transcription     Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  editorId          String
  editorEmail       String?
  editorRole        UserRole?

  editType          EditType     @default(WORD_CORRECTION)
  originalText      String?
  editedText        String?
  position          Float?       // audio timestamp

  metadata          Json?

  createdAt         DateTime     @default(now())

  @@index([transcriptionId])
}

enum EditType {
  WORD_CORRECTION
  SPEAKER_ASSIGNMENT
  PUNCTUATION
  INAUDIBLE_MARK
  FORMATTING
}

// ============================================
// AI REVIEW
// ============================================

model AIRule {
  id          String      @id @default(cuid())
  name        String
  category    RuleCategory
  description String
  enabled     Boolean     @default(true)
  priority    Int         @default(0)  // Higher runs first
  
  // Rule definition
  ruleType    String      // "regex", "llm", "dictionary"
  pattern     String?     // For regex
  replacement String?     // For simple replacements
  prompt      String?     @db.Text  // For LLM rules
  
  // Examples
  examples    Json?       // Before/after pairs
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([enabled, priority])
}

enum RuleCategory {
  CAPITALIZATION
  PUNCTUATION
  FORMATTING
  LEGAL_TERMS
  SPEAKER_ID
  NUMBERS
  DATES
  CUSTOM
}

// ============================================
// SCOPIST WORKFLOW
// ============================================

model JobAssignment {
  id            String      @id @default(cuid())
  jobId         String
  job           Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  scopistId     String
  scopist       User        @relation(fields: [scopistId], references: [id])
  
  status        AssignmentStatus @default(INVITED)
  
  // Timing
  invitedAt     DateTime    @default(now())
  respondedAt   DateTime?
  startedAt     DateTime?
  submittedAt   DateTime?
  
  // Notes
  scopistNotes  String?     @db.Text
  
  @@index([jobId])
  @@index([scopistId, status])
}

enum AssignmentStatus {
  INVITED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  RELEASED
}

// ============================================
// COMMUNICATION
// ============================================

model Message {
  id          String      @id @default(cuid())
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  senderId    String
  sender      User        @relation(fields: [senderId], references: [id])
  
  content     String      @db.Text
  
  // Metadata
  isRead      Boolean     @default(false)
  readAt      DateTime?
  
  createdAt   DateTime    @default(now())
  
  @@index([jobId, createdAt])
}

model Notification {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        NotificationType
  title       String
  message     String
  
  // Link
  linkUrl     String?
  linkText    String?
  
  // Status
  isRead      Boolean     @default(false)
  readAt      DateTime?
  emailSent   Boolean     @default(false)
  emailSentAt DateTime?
  
  // Related job
  jobId       String?
  
  createdAt   DateTime    @default(now())
  
  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  JOB_ASSIGNED
  TRANSCRIPTION_COMPLETE
  AI_REVIEW_COMPLETE
  SCOPIST_ACCEPTED
  SCOPIST_DECLINED
  SCOPIST_SUBMITTED
  REPORTER_REVIEWED
  JOB_COMPLETE
  SYSTEM_ERROR
  MESSAGE_RECEIVED
}

// ============================================
// AUDIT & SECURITY
// ============================================

model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  
  action      String      // "view_job", "edit_transcript", "export_file"
  resource    String      // "Job", "Transcript"
  resourceId  String
  
  // Details
  details     Json?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime    @default(now())
  
  @@index([userId, createdAt])
  @@index([resourceId])
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfig {
  id          String      @id @default(cuid())
  key         String      @unique
  value       Json
  description String?
  
  updatedAt   DateTime    @updatedAt
}

model Firm {
  id        String   @id
  name      String
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs      Job[]
  cases     Case[]
}

// ============================================
// CASE INTAKE SYSTEM
// ============================================

model Case {
  id        String   @id @default(cuid())
  
  // Multi-tenant
  firmId    String?
  firm      Firm?    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  
  // Created by
  createdById String
  createdBy   User   @relation("CaseCreator", fields: [createdById], references: [id])
  
  // Case Information
  caseNumber    String
  caseStyle     String    // Full case name (Plaintiff v. Defendant)
  shortTitle    String?   // Short reference name
  
  // Court Information
  courtName     String?   // e.g., "419th Judicial District Court"
  courtType     String?   // e.g., "District Court", "County Court"
  county        String?
  state         String    @default("Texas")
  judgeAssigned String?
  
  // Parties (stored as JSON arrays)
  plaintiffs    Json?     // [{ name, type, role }]
  defendants    Json?     // [{ name, type, role }]
  otherParties  Json?     // [{ name, type, role }]
  
  // Related Jobs
  jobs          Job[]
  
  // Attorneys on the case
  attorneys     CaseAttorney[]
  
  // Custom dictionary terms extracted from this case
  extractedTerms CaseExtractedTerm[]
  
  // Source documents
  sourceDocuments CaseDocument[]
  
  // Metadata
  status        CaseStatus @default(ACTIVE)
  notes         String?    @db.Text
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@unique([firmId, caseNumber])
  @@index([firmId])
  @@index([caseNumber])
  @@index([createdById])
}

enum CaseStatus {
  ACTIVE
  CLOSED
  SETTLED
  ARCHIVED
}

model CaseAttorney {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  // Attorney info
  name          String
  barNumber     String?
  firm          String?
  role          AttorneyRole
  representing  String?     // Which party they represent
  
  // Contact info
  email         String?
  phone         String?
  fax           String?
  address       String?     @db.Text
  city          String?
  state         String?
  zipCode       String?
  
  // Delivery preferences
  deliveryFormat    String?   // "E-Trans", "Hard Copy", "Both"
  deliveryPriority  String?   // "Standard", "Rush"
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([caseId])
  @@index([email])
}

enum AttorneyRole {
  PLAINTIFF_COUNSEL
  DEFENSE_COUNSEL
  ORDERING_ATTORNEY
  COPY_ATTORNEY
  OTHER
}

model CaseDocument {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  // File info
  documentType  CaseDocumentType
  fileName      String
  fileUrl       String
  fileSize      Int
  mimeType      String
  
  // Extraction status
  extractionStatus  ExtractionStatus @default(PENDING)
  extractedData     Json?            // Raw extracted data from AI
  extractedAt       DateTime?
  extractionError   String?          @db.Text
  
  // Upload info
  uploadedById      String
  uploadedAt        DateTime         @default(now())
  
  @@index([caseId])
  @@index([documentType])
}

enum CaseDocumentType {
  NOTICE_OF_DEPOSITION
  CSR_PAPERWORK
  DEPO_NOTES
  COURT_ORDER
  SUBPOENA
  EXHIBIT_LIST
  OTHER
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CaseExtractedTerm {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  term          String
  category      TermCategory
  phonetic      String?     // Optional pronunciation hint
  source        String?     // Which document it came from
  confidence    Float?      // AI confidence score
  
  // Whether to use in Deepgram
  useInTranscription  Boolean @default(true)
  
  createdAt     DateTime @default(now())
  
  @@unique([caseId, term])
  @@index([caseId])
  @@index([category])
}

enum TermCategory {
  PERSON_NAME
  COMPANY_NAME
  PLACE_NAME
  LEGAL_TERM
  MEDICAL_TERM
  TECHNICAL_TERM
  CASE_SPECIFIC
}
