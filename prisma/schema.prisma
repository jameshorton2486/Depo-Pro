// ═══════════════════════════════════════════════════════════════
// DEPO-PRO DATABASE SCHEMA (Prisma ORM)
// ═══════════════════════════════════════════════════════════════
// Phase 1: Full schema with multi-tenant security
// 🔒 = Multi-tenant security critical field

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────────
// ENUMS
// ───────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  COURT_REPORTER
  SCOPIST
}

enum FirmType {
  AGENCY
  INDEPENDENT
}

enum JobStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  BILLED
  PAID
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum FileType {
  AUDIO
  VIDEO
  TRANSCRIPT
  EXHIBIT
  WORDLIST
  OTHER
}

enum TranscriptStatus {
  DRAFT
  REVIEW
  FINAL
}

enum TranscriptSource {
  MANUAL
  DEEPGRAM
  IMPORTED
}

enum TermCategory {
  NAME
  PLACE
  TECHNICAL
  MEDICAL
  LEGAL
  OTHER
}

// ───────────────────────────────────────────────────────────────
// USER MODEL
// ───────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?   // Nullable for OAuth-only users
  role          Role      @default(SCOPIST)
  
  // 🔒 Multi-tenant relationship
  firmId        String?   // Nullable for now, required later in Phase 2
  firm          Firm?     @relation(fields: [firmId], references: [id])
  
  // OAuth fields (Phase 2)
  oauthProvider String?   // "google" | "microsoft"
  oauthId       String?   // Provider's user ID
  
  // Account status
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  jobsCreated     Job[]               @relation("ReporterJobs")
  jobAssignments  JobAssignment[]
  filesUploaded   JobFile[]
  transcriptsCreated Transcript[]
  dictionaryTermsAdded JobDictionaryTerm[]

  // Indexes for performance and security
  @@index([email])
  @@index([firmId])  // 🔒 Critical for multi-tenant queries
  @@index([role])
}

// ───────────────────────────────────────────────────────────────
// FIRM MODEL (Multi-tenant parent)
// ───────────────────────────────────────────────────────────────

model Firm {
  id           String    @id @default(cuid())
  name         String
  type         FirmType  @default(INDEPENDENT)
  
  // Contact information
  contactEmail String
  contactPhone String?
  address      String?
  
  // Settings stored as JSON (can be promoted to separate table later)
  settings     String?   @default("{}")
  
  // Timestamps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // Relations
  users        User[]
  jobs         Job[]

  @@index([name])
}

// ───────────────────────────────────────────────────────────────
// JOB MODEL (Core entity)
// ───────────────────────────────────────────────────────────────

model Job {
  id          String    @id @default(cuid())
  
  // Case details
  title       String
  caseName    String?
  caseNumber  String?
  court       String?
  depoDate    DateTime?
  location    String?
  
  // 🔒 Ownership and multi-tenant security
  reporterId  String
  reporter    User      @relation("ReporterJobs", fields: [reporterId], references: [id])
  firmId      String    // 🔒 CRITICAL: Every query MUST filter by this
  firm        Firm      @relation(fields: [firmId], references: [id])
  
  // Job metadata
  status      JobStatus @default(DRAFT)
  totalPages  Int?
  rushOrder   Boolean   @default(false)
  difficulty  Int?      // 1-5 scale for complexity
  
  // Client information (for invoicing in Phase 3)
  clientName    String?
  clientContact String?
  
  // Additional notes
  notes       String?
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  
  // Relations
  assignments     JobAssignment[]
  files           JobFile[]
  transcripts     Transcript[]
  dictionaryTerms JobDictionaryTerm[]

  // Indexes for performance and security
  @@index([firmId])      // 🔒 CRITICAL: Multi-tenant isolation
  @@index([reporterId])  // Find jobs by reporter
  @@index([status])      // Filter by status
  @@index([depoDate])    // Sort by deposition date
  @@index([caseNumber])  // Search by case number
}

// ───────────────────────────────────────────────────────────────
// JOB ASSIGNMENT MODEL (Reporter assigns job to Scopist)
// ───────────────────────────────────────────────────────────────

model JobAssignment {
  id        String           @id @default(cuid())
  
  // Relationships
  jobId     String
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scopistId String
  scopist   User             @relation(fields: [scopistId], references: [id])
  
  // Assignment status
  status    AssignmentStatus @default(PENDING)
  notes     String?
  
  // Timestamps
  assignedAt  DateTime       @default(now())
  acceptedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Indexes and constraints
  @@index([jobId])
  @@index([scopistId])
  @@unique([jobId, scopistId])  // Prevent duplicate assignments
}

// ───────────────────────────────────────────────────────────────
// JOB FILE MODEL (File metadata - Phase 1, actual storage Phase 2)
// ───────────────────────────────────────────────────────────────

model JobFile {
  id           String   @id @default(cuid())
  
  // Relationships
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  
  // File metadata
  filename     String   // Sanitized filename for storage
  originalName String   // Original upload name
  mimeType     String
  size         Int      // File size in bytes
  
  // Storage (Phase 2 - placeholder for now)
  storageKey   String   // TODO: S3 key or Supabase path
  storageUrl   String?  // TODO: Signed URL for download
  
  fileType     FileType @default(OTHER)
  
  // Additional metadata (JSON for flexibility)
  metadata     String?  @default("{}")
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Indexes
  @@index([jobId])
  @@index([uploadedById])
  @@index([fileType])
}

// ───────────────────────────────────────────────────────────────
// TRANSCRIPT MODEL (Phase 1: basic, Phase 2: Deepgram integration)
// ───────────────────────────────────────────────────────────────

model Transcript {
  id            String           @id @default(cuid())
  
  // Relationship
  jobId         String
  job           Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // Version tracking
  version       Int              @default(1)
  isCurrent     Boolean          @default(true)
  status        TranscriptStatus @default(DRAFT)
  
  // Transcript content (Phase 1: minimal)
  rawText       String?   // Plain text transcript
  formattedText String?   // TODO: Template-applied version
  
  // Deepgram integration (Phase 2)
  deepgramJson  String?  // TODO: Full Deepgram API response
  source        TranscriptSource @default(MANUAL)
  engineVersion String?          // TODO: Deepgram model version
  
  // Template (Phase 2)
  templateUsed  String?          // TODO: Template name/ID
  
  // Creator
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  
  // Timestamps
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Indexes
  @@index([jobId])
  @@index([isCurrent])  // Quickly find current version
}

// ───────────────────────────────────────────────────────────────
// JOB DICTIONARY TERM MODEL (Case-specific terminology)
// ───────────────────────────────────────────────────────────────

model JobDictionaryTerm {
  id        String        @id @default(cuid())
  
  // Relationship
  jobId     String
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // Term details
  term      String
  phonetic  String?       // Phonetic spelling
  notes     String?
  category  TermCategory?
  
  // Creator
  addedById String
  addedBy   User          @relation(fields: [addedById], references: [id])
  
  // Timestamps
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Indexes
  @@index([jobId])
  @@index([category])
  @@index([term])  // For search functionality
}
