// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          UserRole
  
  // Profile
  firstName     String
  lastName      String
  phone         String?
  photo         String?   // URL to Supabase Storage
  timezone      String    @default("America/New_York")
  
  // Reporter-specific
  agencyName    String?
  csrNumber     String?   // Certified Shorthand Reporter number
  
  // Scopist-specific
  specialties   String[]  // ["medical", "technical", "legal"]
  experienceLevel String? // "beginner", "intermediate", "expert"
  availability  Boolean   @default(true)
  
  // Settings
  defaultTranscriptSettings Json?
  notificationPreferences   Json?
  
  // Relationships
  jobsCreated       Job[]           @relation("CreatedBy")
  assignments       JobAssignment[]
  messages          Message[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  @@index([email])
  @@index([role])
}

enum UserRole {
  REPORTER
  SCOPIST
  ADMIN
}

// ============================================
// JOB MODELS
// ============================================

model Job {
  id              String      @id @default(cuid())
  
  // Basic Info
  title           String
  caseName        String
  caseNumber      String?
  depositionDate  DateTime
  location        String?     // Physical address or "Zoom"
  zoomLink        String?
  
  // Status
  status          JobStatus   @default(CREATED)
  
  // Assignment
  createdById     String
  createdBy       User        @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId    String?     // If self-edit, same as createdById
  
  // Files
  files           JobFile[]
  
  // Transcription
  transcriptionJobs TranscriptionJob[]
  transcripts       Transcript[]
  
  // Communication
  messages        Message[]
  assignments     JobAssignment[]
  
  // Metadata
  notes           String?     @db.Text
  internalNotes   String?     @db.Text // Private notes not visible to scopist
  
  // Lock system
  lockedBy        String?
  lockedAt        DateTime?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?
  
  @@index([createdById])
  @@index([status])
  @@index([depositionDate])
}

enum JobStatus {
  CREATED
  FILES_UPLOADED
  ENHANCING_AUDIO
  TRANSCRIBING
  AI_REVIEWING
  READY_FOR_EDIT
  ASSIGNED
  IN_EDIT
  SUBMITTED_FOR_REVIEW
  IN_REVIEW
  COMPLETED
  CANCELLED
}

model JobFile {
  id          String      @id @default(cuid())
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  type        FileType
  fileName    String
  fileSize    Int         // bytes
  mimeType    String
  
  // Storage
  storageUrl  String      // Supabase Storage URL
  storagePath String      // Path in bucket
  
  // For extracted data (Notice, Court Order)
  extractedData Json?
  
  createdAt   DateTime    @default(now())
  
  @@index([jobId, type])
}

enum FileType {
  AUDIO
  VIDEO
  NOTICE
  COURT_ORDER
  ROUGH_TRANSCRIPT
  EXHIBIT
  FINAL_TRANSCRIPT
}

// ============================================
// AUDIO ENHANCEMENT
// ============================================

model AudioEnhancement {
  id                  String    @id @default(cuid())
  jobId               String
  
  // Input
  originalAudioUrl    String
  originalDuration    Float     // seconds
  originalFileSize    Int       // bytes
  
  // Enhancement
  enhancementMode     EnhancementMode
  dolbyProcessed      Boolean   @default(false)
  dolbyAudioUrl       String?
  dolbyQualityScore   Float?    // 0-100
  
  auphonicProcessed   Boolean   @default(false)
  auphonicAudioUrl    String?
  auphonicQualityScore Float?
  
  finalAudioUrl       String    // The one sent to Deepgram
  engineUsed          String    // "dolby", "auphonic", or "none"
  
  // Cost tracking
  dolbyCostCents      Int?
  auphonicCostCents   Int?
  totalCostCents      Int
  
  // Metadata
  qualityFlags        Json?     // {"noise": "high", "clipping": "low"}
  decisionReason      String?   // Why Auphonic was/wasn't used
  
  status              EnhancementStatus @default(PENDING)
  errorMessage        String?
  
  createdAt           DateTime  @default(now())
  completedAt         DateTime?
  
  @@index([jobId])
}

enum EnhancementMode {
  OFF
  DOLBY_ONLY
  HYBRID
  AUPHONIC_ONLY
}

enum EnhancementStatus {
  PENDING
  PROCESSING_DOLBY
  PROCESSING_AUPHONIC
  COMPLETED
  ERROR
}

// ============================================
// TRANSCRIPTION
// ============================================

model TranscriptionJob {
  id                  String      @id @default(cuid())
  jobId               String
  job                 Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // Deepgram
  deepgramRequestId   String      @unique
  audioUrl            String      // Enhanced audio URL
  
  // Configuration
  config              Json        // Deepgram options used
  
  // Status
  status              TranscriptionStatus @default(PENDING)
  
  // Results
  rawJson             Json?       // Full Deepgram response
  duration            Float?      // Audio duration
  wordCount           Int?
  averageConfidence   Float?
  speakerCount        Int?
  
  // Error handling
  errorMessage        String?
  retryCount          Int         @default(0)
  maxRetries          Int         @default(3)
  
  createdAt           DateTime    @default(now())
  completedAt         DateTime?
  
  @@index([jobId])
  @@index([status])
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
  CANCELLED
}

model Transcript {
  id                String      @id @default(cuid())
  jobId             String
  job               Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // Version
  version           String      // "1.0-raw", "2.0-ai-reviewed", "3.0-scopist", "4.0-final"
  versionNumber     Int         // 1, 2, 3, 4
  
  // Content
  content           String      @db.Text  // Plain text
  contentJson       Json        // TipTap JSON document
  
  // Tokens (for audio sync)
  tokens            TranscriptToken[]
  
  // Metadata
  wordCount         Int?
  pageCount         Int?
  averageConfidence Float?
  speakerCount      Int?
  
  // AI Review (for version 2.0)
  aiChanges         Json?       // List of changes made
  aiFlags           Json?       // Low-confidence sections
  
  // Creator
  createdBy         String      // "system", userId
  
  createdAt         DateTime    @default(now())
  
  @@unique([jobId, version])
  @@index([jobId, versionNumber])
}

model TranscriptToken {
  id            String      @id @default(cuid())
  transcriptId  String
  transcript    Transcript  @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  
  // Position in transcript
  index         Int         // Word index in document
  
  // Content
  word          String
  punctuatedWord String?    // With punctuation
  
  // Timing
  start         Float       // seconds
  end           Float       // seconds
  
  // Quality
  confidence    Float       // 0.0 - 1.0
  isFlagged     Boolean     @default(false)  // confidence < 0.80
  isReviewed    Boolean     @default(false)  // User marked as reviewed
  
  // Speaker
  speaker       Int?        // Speaker ID from diarization
  
  createdAt     DateTime    @default(now())
  
  @@index([transcriptId, index])
  @@index([transcriptId, isFlagged])
}

// ============================================
// AI REVIEW
// ============================================

model AIRule {
  id          String      @id @default(cuid())
  name        String
  category    RuleCategory
  description String
  enabled     Boolean     @default(true)
  priority    Int         @default(0)  // Higher runs first
  
  // Rule definition
  ruleType    String      // "regex", "llm", "dictionary"
  pattern     String?     // For regex
  replacement String?     // For simple replacements
  prompt      String?     @db.Text  // For LLM rules
  
  // Examples
  examples    Json?       // Before/after pairs
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([enabled, priority])
}

enum RuleCategory {
  CAPITALIZATION
  PUNCTUATION
  FORMATTING
  LEGAL_TERMS
  SPEAKER_ID
  NUMBERS
  DATES
  CUSTOM
}

// ============================================
// SCOPIST WORKFLOW
// ============================================

model JobAssignment {
  id            String      @id @default(cuid())
  jobId         String
  job           Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  scopistId     String
  scopist       User        @relation(fields: [scopistId], references: [id])
  
  status        AssignmentStatus @default(INVITED)
  
  // Timing
  invitedAt     DateTime    @default(now())
  respondedAt   DateTime?
  startedAt     DateTime?
  submittedAt   DateTime?
  
  // Notes
  scopistNotes  String?     @db.Text
  
  @@index([jobId])
  @@index([scopistId, status])
}

enum AssignmentStatus {
  INVITED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  RELEASED
}

// ============================================
// COMMUNICATION
// ============================================

model Message {
  id          String      @id @default(cuid())
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  senderId    String
  sender      User        @relation(fields: [senderId], references: [id])
  
  content     String      @db.Text
  
  // Metadata
  isRead      Boolean     @default(false)
  readAt      DateTime?
  
  createdAt   DateTime    @default(now())
  
  @@index([jobId, createdAt])
}

model Notification {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        NotificationType
  title       String
  message     String
  
  // Link
  linkUrl     String?
  linkText    String?
  
  // Status
  isRead      Boolean     @default(false)
  readAt      DateTime?
  emailSent   Boolean     @default(false)
  emailSentAt DateTime?
  
  // Related job
  jobId       String?
  
  createdAt   DateTime    @default(now())
  
  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  JOB_ASSIGNED
  TRANSCRIPTION_COMPLETE
  AI_REVIEW_COMPLETE
  SCOPIST_ACCEPTED
  SCOPIST_DECLINED
  SCOPIST_SUBMITTED
  REPORTER_REVIEWED
  JOB_COMPLETE
  SYSTEM_ERROR
  MESSAGE_RECEIVED
}

// ============================================
// AUDIT & SECURITY
// ============================================

model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  
  action      String      // "view_job", "edit_transcript", "export_file"
  resource    String      // "Job", "Transcript"
  resourceId  String
  
  // Details
  details     Json?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime    @default(now())
  
  @@index([userId, createdAt])
  @@index([resourceId])
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfig {
  id          String      @id @default(cuid())
  key         String      @unique
  value       Json
  description String?
  
  updatedAt   DateTime    @updatedAt
}
