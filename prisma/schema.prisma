generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                        @id // Supabase auth user ID (UUID)
  email                      String                        @unique
  role                       UserRole
  firmId                     String?
  firstName                  String
  lastName                   String
  phone                      String?
  photo                      String?
  timezone                   String                        @default("America/New_York")
  agencyName                 String?
  csrNumber                  String?
  specialties                String[]
  experienceLevel            String?
  availability               Boolean                       @default(true)
  defaultTranscriptSettings  Json?
  notificationPreferences    Json?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  lastLoginAt                DateTime?
  deletedAt                  DateTime?
  agencyId                   String?
  attorneyProfile            AttorneyProfile?
  attorneyTranscriptsCreated AttorneyTranscript[]          @relation("TranscriptCreator")
  auditLogs                  AuditLog[]
  casesCreated               Case[]                        @relation("CaseCreator")
  caseMemberships            CaseMembership[]
  exhibitsCreated            Exhibit[]
  jobsCreated                Job[]                         @relation("CreatedBy")
  assignments                JobAssignment[]
  scopistClaims              JobClaim[]                    @relation("ScopistClaims")
  marketplaceSettings        MarketplaceSettings?          @relation("MarketplaceSettings")
  messages                   Message[]
  notifications              Notification[]
  reporterUnavailability     ReporterUnavailability[]      @relation("ReporterUnavailability")
  transcriptAccessGranted    TranscriptAccess[]            @relation("TranscriptAccessGranter")
  transcriptAccess           TranscriptAccess[]            @relation("TranscriptAccessUser")
  transcriptAnnotations      TranscriptAnnotation[]
  annotationExhibitLinks     TranscriptAnnotationExhibit[]
  transcriptBookmarks        TranscriptBookmark[]
  transcriptHighlights       TranscriptHighlight[]
  transcriptNotes            TranscriptNote[]
  transcriptShares           TranscriptShare[]
  userTags                   TranscriptTag[]               @relation("UserTags")
  agency                     Agency?                       @relation("AgencyReporters", fields: [agencyId], references: [id])
  firm                       Firm?                         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  bookingRequests            BookingRequest[]
  bookingResponses           BookingRequest[]              @relation("AgencyResponder")
  reporterAssignments        CalendarEvent[]               @relation("ReporterAssignments")
  reviewSessions             TranscriptReviewSession[]
  eventsCreated              CalendarEvent[]               @relation("EventCreator")
  attorneyRequests           CalendarEvent[]               @relation("AttorneyRequests")
  agencyScheduled            CalendarEvent[]               @relation("AgencyScheduled")
  eventParticipations        EventParticipant[]
  reporterAvailability       ReporterAvailability[]
  calendarEventNotes         CalendarEventNote[]           @relation("NoteCreator")
  calendarAuditLogs          CalendarAuditLog[]            @relation("AuditPerformer")
  rescheduledEvents          CalendarEvent[]               @relation("EventRescheduler")
  resolvedConflicts          ScheduleConflict[]            @relation("ConflictResolver")
  externalCalendars          ExternalCalendarConnection[]
  // Phase 6A: Notes & Templates
  reporterNotes              DepositionNote[]              @relation("ReporterNotes")
  createdTemplates           DocumentTemplate[]            @relation("TemplateCreator")
  // Phase 6B: Audio Processing Sessions
  audioProcessingSessions    AudioProcessingSession[]      @relation("AudioProcessingSessions")
  // Job Locking
  lockedJobs                 Job[]                         @relation("JobLockedBy")

  @@index([email])
  @@index([role])
  @@index([firmId])
  @@index([firmId, role])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lastLoginAt])
}

model Job {
  id                       String                     @id @default(cuid())
  title                    String
  caseName                 String
  caseNumber               String?
  depositionDate           DateTime
  location                 String?
  zoomLink                 String?
  status                   JobStatus                  @default(CREATED)
  firmId                   String?
  createdById              String
  assignedToId             String?
  caseId                   String?
  transcriptionModelType   String?                    @default("MEDICAL")
  transcriptionCompletedAt DateTime?
  errorMessage             String?
  notes                    String?
  internalNotes            String?
  lockedBy                 String?
  lockedAt                 DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  completedAt              DateTime?
  dueDate                  DateTime?
  scopistId                String?
  deletedAt                DateTime?
  agencyId                 String?
  // Phase 6B: Audio Processing & Billing
  audioProcessingMode      AudioProcessingMode        @default(AUTOMATED)
  asrModelTier             ASRModelTier               @default(STANDARD)
  pricingSnapshotId        String? // Locked pricing at job creation
  audioDurationMinutes     Float? // Captured for billing
  audioDurationSeconds     Int? // Original duration in seconds
  pricingSnapshot          PricingSnapshot?           @relation("JobPricingSnapshot", fields: [pricingSnapshotId], references: [id])
  csrRecord                CSRRecord?                 @relation("JobCSRRecord")
  exhibits                 Exhibit[]
  agency                   Agency?                    @relation("AgencyJobs", fields: [agencyId], references: [id])
  case                     Case?                      @relation(fields: [caseId], references: [id])
  createdBy                User                       @relation("CreatedBy", fields: [createdById], references: [id])
  firm                     Firm?                      @relation(fields: [firmId], references: [id])
  assignments              JobAssignment[]
  claims                   JobClaim[]                 @relation("JobClaims")
  jobExhibits              JobExhibit[]               @relation("JobExhibits")
  files                    JobFile[]
  messages                 Message[]
  transcripts              Transcript[]
  transcription            Transcription?
  transcriptionJobs        TranscriptionJob[]
  calendarEvent            CalendarEvent?
  // Phase 6A: Remote Meetings, Notes, Templates
  remoteMeetingInfo        RemoteMeetingInfo?
  depositionNotes          DepositionNote[]
  templateSnapshots        DocumentTemplateSnapshot[]
  // Phase 6B: Audio Processing Sessions
  audioProcessingSessions  AudioProcessingSession[]

  // Job Locking
  lockedByUser User? @relation("JobLockedBy", fields: [lockedBy], references: [id])

  @@index([createdById])
  @@index([firmId])
  @@index([status])
  @@index([scopistId])
  @@index([firmId, status])
  @@index([firmId, createdById])
  @@index([firmId, scopistId])
  @@index([status, dueDate])
  @@index([caseId])
  @@index([depositionDate])
  @@index([dueDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([completedAt])
  @@index([audioProcessingMode])
  @@index([asrModelTier])
  @@index([pricingSnapshotId])
}

model JobFile {
  id            String      @id @default(cuid())
  jobId         String
  type          FileType
  fileName      String
  fileSize      Int
  mimeType      String
  storageUrl    String
  storagePath   String
  extractedData Json?
  createdAt     DateTime    @default(now())
  exhibitLink   JobExhibit? @relation("ExhibitFile")
  job           Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, type])
}

model Exhibit {
  id              String                        @id @default(cuid())
  caseId          String
  jobId           String?
  exhibitLabel    String
  exhibitNumber   Int?
  description     String
  originalFileUrl String
  stampedFileUrl  String?
  fileType        String
  mimeType        String
  fileName        String
  fileSize        Int
  stamped         Boolean                       @default(false)
  uploadedByRole  UserRole
  createdById     String
  createdAt       DateTime                      @default(now())
  case            Case                          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy       User                          @relation(fields: [createdById], references: [id])
  job             Job?                          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  annotationLinks TranscriptAnnotationExhibit[]

  @@unique([caseId, jobId, exhibitLabel])
  @@index([caseId])
  @@index([jobId])
  @@index([createdById])
  @@index([uploadedByRole])
  @@index([stamped])
  @@index([createdAt])
}

model AudioEnhancement {
  id                   String          @id @default(cuid())
  jobId                String
  originalAudioUrl     String
  originalDuration     Float
  originalFileSize     Int
  enhancementMode      EnhancementMode
  dolbyProcessed       Boolean         @default(false)
  dolbyAudioUrl        String?
  dolbyQualityScore    Float?
  auphonicProcessed    Boolean         @default(false)
  auphonicAudioUrl     String?
  auphonicQualityScore Float?
  finalAudioUrl        String
  engineUsed           String
  dolbyCostCents       Int?
  auphonicCostCents    Int?
  totalCostCents       Int
  qualityFlags         Json?
  decisionReason       String?
  createdAt            DateTime        @default(now())
  completedAt          DateTime?

  @@index([jobId])
  @@index([createdAt])
  @@index([completedAt])
}

model TranscriptionJob {
  id                String              @id @default(cuid())
  jobId             String
  deepgramRequestId String              @unique
  audioUrl          String
  config            Json
  status            TranscriptionStatus @default(PENDING)
  rawJson           Json?
  duration          Float?
  wordCount         Int?
  averageConfidence Float?
  speakerCount      Int?
  errorMessage      String?
  retryCount        Int                 @default(0)
  maxRetries        Int                 @default(3)
  createdAt         DateTime            @default(now())
  completedAt       DateTime?
  job               Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@index([completedAt])
}

model Transcript {
  id                String                @id @default(cuid())
  jobId             String
  version           String
  versionNumber     Int
  content           String
  contentJson       Json
  wordCount         Int?
  pageCount         Int?
  averageConfidence Float?
  speakerCount      Int?
  aiChanges         Json?
  aiFlags           Json?
  createdBy         String
  createdAt         DateTime              @default(now())
  deletedAt         DateTime?
  job               Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  accessGrants      TranscriptAccess[]
  bookmarks         TranscriptBookmark[]
  highlights        TranscriptHighlight[]
  notes             TranscriptNote[]
  shares            TranscriptShare[]
  tokens            TranscriptToken[]

  @@unique([jobId, version])
  @@index([jobId, versionNumber])
  @@index([createdAt])
}

model TranscriptToken {
  id             String     @id @default(cuid())
  transcriptId   String
  index          Int
  word           String
  punctuatedWord String?
  start          Float
  end            Float
  confidence     Float
  isFlagged      Boolean    @default(false)
  isReviewed     Boolean    @default(false)
  speaker        Int?
  createdAt      DateTime   @default(now())
  transcript     Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, index])
  @@index([transcriptId, isFlagged])
  @@index([createdAt])
}

model Transcription {
  id                 String                    @id @default(cuid())
  jobId              String                    @unique
  fullTranscript     String
  deepgramRawJson    String?
  words              Json
  utterances         Json?
  flaggedSegments    Json?
  speakerAnalysis    Json?
  speakerAssignments Json?
  duration           Float?
  wordCount          Int?
  flaggedWordCount   Int?
  averageConfidence  Float?
  speakerCount       Int                       @default(0)
  modelUsed          String?
  status             TranscriptionStatus       @default(PENDING)
  version            Int                       @default(1)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  lockReason         String?
  lockedAt           DateTime?
  lockedBy           String?
  // Review Tracking (B3 fix)
  reviewTimeMinutes  Int?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  job                Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  edits              TranscriptionEdit[]
  reviewSessions     TranscriptReviewSession[]

  @@index([jobId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lockedAt])
}

model TranscriptionEdit {
  id              String        @id @default(cuid())
  transcriptionId String
  editorId        String
  editorEmail     String?
  editorRole      UserRole?
  editType        EditType      @default(WORD_CORRECTION)
  originalText    String?
  editedText      String?
  position        Float?
  metadata        Json?
  createdAt       DateTime      @default(now())
  transcription   Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  @@index([transcriptionId])
  @@index([createdAt])
}

// Review session persistence for transcript review workflow
model TranscriptReviewSession {
  id              String   @id @default(cuid())
  transcriptionId String
  userId          String
  reviewedIndices Int[] // Array of word indices marked as reviewed
  corrections     Json // Map of { wordIndex: correctedText }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transcription Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([transcriptionId, userId])
  @@index([transcriptionId])
  @@index([userId])
}

model AIRule {
  id          String       @id @default(cuid())
  name        String
  category    RuleCategory
  description String
  enabled     Boolean      @default(true)
  priority    Int          @default(0)
  ruleType    String
  pattern     String?
  replacement String?
  prompt      String?
  examples    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([enabled, priority])
  @@index([createdAt])
  @@index([updatedAt])
}

model JobAssignment {
  id           String           @id @default(cuid())
  jobId        String
  scopistId    String
  status       AssignmentStatus @default(INVITED)
  invitedAt    DateTime         @default(now())
  respondedAt  DateTime?
  startedAt    DateTime?
  submittedAt  DateTime?
  scopistNotes String?
  job          Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scopist      User             @relation(fields: [scopistId], references: [id])

  @@index([jobId])
  @@index([scopistId, status])
  @@index([invitedAt])
  @@index([respondedAt])
  @@index([startedAt])
  @@index([submittedAt])
}

model Message {
  id        String    @id @default(cuid())
  jobId     String
  senderId  String
  content   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id])

  @@index([jobId, createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  linkUrl     String?
  linkText    String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  emailSent   Boolean          @default(false)
  emailSentAt DateTime?
  jobId       String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actorUserId String?
  firmId      String?
  metadata    Json?
  targetId    String
  targetType  String
  user        User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([firmId])
  @@index([action])
  @@index([targetType])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([firmId, createdAt])
  @@index([firmId, action])
}

model UsageRecord {
  id        String   @id @default(cuid())
  firmId    String
  type      String
  amount    Float
  createdAt DateTime @default(now())
  firm      Firm     @relation(fields: [firmId], references: [id])

  @@index([firmId])
  @@index([type])
  @@index([createdAt])
  @@index([firmId, type])
  @@index([firmId, createdAt])
  @@index([firmId, type, createdAt])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model Firm {
  id                          String                       @id @default(cuid())
  name                        String
  address                     String?
  phone                       String?
  email                       String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  agencyId                    String?
  cases                       Case[]
  agency                      Agency?                      @relation("AgencyFirms", fields: [agencyId], references: [id])
  jobs                        Job[]
  tags                        TranscriptTag[]
  usageRecords                UsageRecord[]
  users                       User[]
  webhooks                    WebhookConfig[]
  bookingRequests             BookingRequest[]
  calendarEvents              CalendarEvent[]
  reporterAvailability        ReporterAvailability[]
  scheduleConflicts           ScheduleConflict[]
  externalCalendarConnections ExternalCalendarConnection[]
  externalCalendarEvents      ExternalCalendarEvent[]
  billingAccount              BillingAccount?
  // Phase 6A: Document Templates
  documentTemplates           DocumentTemplate[]           @relation("FirmTemplates")

  @@index([name])
  @@index([createdAt])
  @@index([updatedAt])
}

model BackgroundJob {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  status         String    @default("PENDING")
  priority       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  scheduledFor   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([scheduledFor])
  @@index([status, scheduledFor])
  @@index([status, priority])
  @@index([idempotencyKey])
  @@index([createdAt])
}

model WebhookConfig {
  id         String            @id @default(cuid())
  firmId     String
  url        String
  secret     String
  events     String[]
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  firm       Firm              @relation(fields: [firmId], references: [id])
  deliveries WebhookDelivery[]

  @@index([firmId])
  @@index([isActive])
  @@index([firmId, isActive])
}

model WebhookDelivery {
  id            String        @id @default(cuid())
  webhookId     String
  event         String
  payload       String
  status        String        @default("pending")
  statusCode    Int?
  attempts      Int           @default(0)
  lastAttemptAt DateTime?
  error         String?
  createdAt     DateTime      @default(now())
  webhook       WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([event])
  @@index([createdAt])
}

model Case {
  id               String              @id @default(cuid())
  firmId           String
  createdById      String
  caseNumber       String
  caseStyle        String
  shortTitle       String?
  courtName        String?
  courtType        String?
  county           String?
  state            String              @default("Texas")
  judgeAssigned    String?
  plaintiffs       Json?
  defendants       Json?
  otherParties     Json?
  status           CaseStatus          @default(ACTIVE)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdBy        User                @relation("CaseCreator", fields: [createdById], references: [id])
  firm             Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  attorneys        CaseAttorney[]
  sourceDocuments  CaseDocument[]
  extractedTerms   CaseExtractedTerm[]
  memberships      CaseMembership[]
  exhibits         Exhibit[]
  jobs             Job[]
  transcriptAccess TranscriptAccess[]
  tags             TranscriptTag[]

  @@unique([firmId, caseNumber])
  @@index([firmId])
  @@index([caseNumber])
  @@index([createdById])
  @@index([createdAt])
  @@index([updatedAt])
}

/// *
///  * CaseMembership - Controls who can access which cases
///  * This is the heart of the multi-tenant permission system.
///  * Key Rules:
///  * - Attorneys can belong to many cases
///  * - Reporters belong only to their deposition's case (via Job)
///  * - Paralegals can be added per case
///  * - Access is granted per case, not globally
model CaseMembership {
  id          String   @id @default(cuid())
  userId      String
  caseId      String
  roleInCase  CaseRole
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId])
  @@index([userId])
  @@index([caseId])
  @@index([roleInCase])
  @@index([createdAt])
  @@index([updatedAt])
}

model CaseAttorney {
  id               String       @id @default(cuid())
  caseId           String
  name             String
  barNumber        String?
  firm             String?
  role             AttorneyRole
  representing     String?
  email            String?
  phone            String?
  fax              String?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  deliveryFormat   String?
  deliveryPriority String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  case             Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([email])
  @@index([createdAt])
  @@index([updatedAt])
}

model CaseDocument {
  id               String           @id @default(cuid())
  caseId           String
  documentType     CaseDocumentType
  fileName         String
  fileUrl          String
  fileSize         Int
  mimeType         String
  extractionStatus ExtractionStatus @default(PENDING)
  extractedData    Json?
  extractedAt      DateTime?
  extractionError  String?
  uploadedById     String
  uploadedAt       DateTime         @default(now())
  case             Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([documentType])
  @@index([uploadedAt])
}

model CaseExtractedTerm {
  id                 String       @id @default(cuid())
  caseId             String
  term               String
  category           TermCategory
  phonetic           String?
  source             String?
  confidence         Float?
  useInTranscription Boolean      @default(true)
  createdAt          DateTime     @default(now())
  case               Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, term])
  @@index([caseId])
  @@index([category])
  @@index([createdAt])
}

/// *
///  * Attorney Transcript - Read-only transcript for attorney review
///  * Stored as JSONB for flexibility (page/line structure)
model AttorneyTranscript {
  id             String                   @id @default(cuid())
  name           String
  deponent       String
  caseName       String?
  depositionDate DateTime?
  status         AttorneyTranscriptStatus @default(NOT_REVIEWED)
  transcriptData Json
  totalPages     Int
  totalLines     Int
  uploadedById   String
  uploadedAt     DateTime                 @default(now())
  uploadedBy     User                     @relation("TranscriptCreator", fields: [uploadedById], references: [id])
  annotations    TranscriptAnnotation[]

  @@index([uploadedById])
  @@index([status])
  @@index([deponent])
  @@index([uploadedAt])
}

/// *
///  * Transcript Annotation - Issue codes tagged on transcript lines
model TranscriptAnnotation {
  id             String                        @id @default(cuid())
  transcriptId   String
  issueCode      String
  issueLabel     String
  issueColor     String
  pageStart      Int
  lineStart      Int
  pageEnd        Int
  lineEnd        Int
  note           String?
  createdById    String
  createdAt      DateTime                      @default(now())
  createdBy      User                          @relation(fields: [createdById], references: [id])
  transcript     AttorneyTranscript            @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  linkedExhibits TranscriptAnnotationExhibit[]

  @@index([transcriptId])
  @@index([createdById])
  @@index([issueCode])
  @@index([createdAt])
}

/// *
///  * Junction table linking transcript annotations to exhibits
///  * Allows attorneys to reference exhibits in their annotations
model TranscriptAnnotationExhibit {
  id           String               @id @default(cuid())
  annotationId String
  exhibitId    String
  createdById  String
  createdAt    DateTime             @default(now())
  annotation   TranscriptAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation(fields: [createdById], references: [id])
  exhibit      Exhibit              @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  @@unique([annotationId, exhibitId])
  @@index([annotationId])
  @@index([exhibitId])
  @@index([createdById])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([createdAt])
  @@index([expires])
}

model CalendarEvent {
  id                  String                 @id @default(cuid())
  firmId              String
  title               String
  eventType           EventType              @default(DEPOSITION)
  status              CalendarEventStatus    @default(REQUESTED)
  startTime           DateTime
  endTime             DateTime
  timezone            String                 @default("America/Chicago")
  allDay              Boolean                @default(false)
  isRecurring         Boolean                @default(false)
  recurrenceRule      String?
  recurrenceEndDate   DateTime?
  parentEventId       String?
  location            String?
  isRemote            Boolean                @default(false)
  meetingLink         String?
  jobId               String?                @unique
  assignedReporterId  String?
  requestedById       String?
  scheduledById       String?
  notes               String?
  internalNotes       String?
  cancellationReason  String?
