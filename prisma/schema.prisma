// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER MODELS
// ============================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole

  // Multi-tenant: Every user belongs to a Firm
  firmId String?
  firm   Firm?   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // Profile
  firstName String
  lastName  String
  phone     String?
  photo     String? // URL to Supabase Storage
  timezone  String  @default("America/New_York")

  // Reporter-specific
  agencyName String?
  csrNumber  String? // Certified Shorthand Reporter number

  // Scopist-specific
  specialties     String[] // ["medical", "technical", "legal"]
  experienceLevel String? // "beginner", "intermediate", "expert"
  availability    Boolean  @default(true)

  // Settings
  defaultTranscriptSettings Json?
  notificationPreferences   Json?

  // Relationships
  jobsCreated                Job[]                         @relation("CreatedBy")
  casesCreated               Case[]                        @relation("CaseCreator")
  assignments                JobAssignment[]
  messages                   Message[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  attorneyTranscriptsCreated AttorneyTranscript[]          @relation("TranscriptCreator")
  transcriptAnnotations      TranscriptAnnotation[]
  exhibitsCreated            Exhibit[]
  annotationExhibitLinks     TranscriptAnnotationExhibit[]

  // Case-level access (multi-case membership)
  caseMemberships CaseMembership[]

  // Calendar relations
  reporterAssignments  CalendarEvent[]      @relation("ReporterAssignments")
  attorneyRequests     CalendarEvent[]      @relation("AttorneyRequests")
  agencyScheduled      CalendarEvent[]      @relation("AgencyScheduled")
  eventsCreated        CalendarEvent[]      @relation("EventCreator")
  eventParticipations  EventParticipant[]
  reporterAvailability ReporterAvailability[]
  bookingRequests      BookingRequest[]
  bookingResponses     BookingRequest[]     @relation("AgencyResponder")

  // Phase 3: Attorney Portal
  attorneyProfile         AttorneyProfile?
  transcriptAccess        TranscriptAccess[] @relation("TranscriptAccessUser")
  transcriptAccessGranted TranscriptAccess[] @relation("TranscriptAccessGranter")
  transcriptShares        TranscriptShare[]
  transcriptHighlights    TranscriptHighlight[]
  userTags                TranscriptTag[] @relation("UserTags")
  transcriptNotes         TranscriptNote[]
  transcriptBookmarks      TranscriptBookmark[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@index([email])
  @@index([role])
  @@index([firmId])
  @@index([firmId, role])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lastLoginAt])
}

enum UserRole {
  REPORTER
  SCOPIST
  ADMIN
  ATTORNEY
  PARALEGAL // Future: paralegals can assist attorneys
  AGENCY // Agency administrators
  AGENCY_ADMIN // Future: agency administrators
  FIRM_ADMIN // Future: firm administrators
}

// ============================================
// JOB MODELS
// ============================================

model Job {
  id String @id @default(cuid())

  // Basic Info
  title          String
  caseName       String
  caseNumber     String?
  depositionDate DateTime
  location       String? // Physical address or "Zoom"
  zoomLink       String?

  // Status
  status JobStatus @default(CREATED)

  // Firm association (optional for now)
  firmId String?
  firm   Firm?   @relation(fields: [firmId], references: [id])

  // Assignment
  createdById  String
  createdBy    User    @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId String? // If self-edit, same as createdById
  scopistId    String?
  dueDate      DateTime?

  // Case association
  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  // Calendar association
  calendarEvent CalendarEvent?

  // Files
  files    JobFile[]
  exhibits Exhibit[]

  // Transcription
  transcriptionJobs        TranscriptionJob[]
  transcription            Transcription?
  transcripts              Transcript[]
  transcriptionModelType   String?            @default("MEDICAL") // STANDARD, MEDICAL, BILINGUAL
  transcriptionCompletedAt DateTime?
  errorMessage             String?

  // Communication
  messages    Message[]
  assignments JobAssignment[]

  // Metadata
  notes         String? @db.Text
  internalNotes String? @db.Text // Private notes not visible to scopist

  // Lock system
  lockedBy String?
  lockedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([createdById])
  @@index([firmId])
  @@index([status])
  @@index([scopistId])
  @@index([firmId, status])
  @@index([firmId, createdById])
  @@index([firmId, scopistId])
  @@index([status, dueDate])
  @@index([caseId])
  @@index([depositionDate])
  @@index([dueDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([completedAt])
}

enum JobStatus {
  CREATED
  FILES_UPLOADED
  ENHANCING_AUDIO
  TRANSCRIBING
  AI_REVIEWING
  READY_FOR_EDIT
  ASSIGNED
  IN_EDIT
  SUBMITTED_FOR_REVIEW
  IN_REVIEW
  SCOPIST_COMPLETE
  REVIEW_COMPLETE
  COMPLETED
  CANCELLED
}

model JobFile {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  type     FileType
  fileName String
  fileSize Int // bytes
  mimeType String

  // Storage
  storageUrl  String // Supabase Storage URL
  storagePath String // Path in bucket

  // For extracted data (Notice, Court Order)
  extractedData Json?

  createdAt DateTime @default(now())

  @@index([jobId, type])
}

// ============================================
// EXHIBITS
// ============================================

model Exhibit {
  id String @id @default(cuid())

  // Dual ownership: Case (required) and Job/Deposition (optional)
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  jobId String? // Nullable - attorney can upload case-global exhibits
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Exhibit identification
  exhibitLabel  String // e.g., "Exhibit 12" or "Exhibit A"
  exhibitNumber Int? // Numeric value if applicable (for sorting)
  description   String

  // File storage
  originalFileUrl String
  stampedFileUrl  String?

  fileType String // PDF, IMAGE, DOCX
  mimeType String
  fileName String
  fileSize Int // bytes

  stamped Boolean @default(false)

  // Upload tracking
  uploadedByRole UserRole // REPORTER, ATTORNEY, ADMIN
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  // Links to transcript annotations
  annotationLinks TranscriptAnnotationExhibit[]

  @@unique([caseId, jobId, exhibitLabel]) // Unique per case+deposition combination
  @@index([caseId])
  @@index([jobId])
  @@index([createdById])
  @@index([uploadedByRole])
  @@index([createdAt])
}

enum FileType {
  AUDIO
  VIDEO
  NOTICE
  COURT_ORDER
  ROUGH_TRANSCRIPT
  EXHIBIT
  FINAL_TRANSCRIPT
}

// ============================================
// AUDIO ENHANCEMENT
// ============================================

model AudioEnhancement {
  id    String @id @default(cuid())
  jobId String

  // Input
  originalAudioUrl String
  originalDuration Float // seconds
  originalFileSize Int // bytes

  // Enhancement
  enhancementMode   EnhancementMode
  dolbyProcessed    Boolean         @default(false)
  dolbyAudioUrl     String?
  dolbyQualityScore Float? // 0-100

  auphonicProcessed    Boolean @default(false)
  auphonicAudioUrl     String?
  auphonicQualityScore Float?

  finalAudioUrl String // The one sent to Deepgram
  engineUsed    String // "dolby", "auphonic", or "none"

  // Cost tracking
  dolbyCostCents    Int?
  auphonicCostCents Int?
  totalCostCents    Int

  // Metadata
  qualityFlags   Json? // {"noise": "high", "clipping": "low"}
  decisionReason String? // Why Auphonic was/wasn't used

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([jobId])
  @@index([createdAt])
  @@index([completedAt])
}

enum EnhancementMode {
  OFF
  DOLBY_ONLY
  HYBRID
  AUPHONIC_ONLY
}

enum EnhancementStatus {
  PENDING
  PROCESSING_DOLBY
  PROCESSING_AUPHONIC
  COMPLETED
  ERROR
}

// ============================================
// TRANSCRIPTION
// ============================================

model TranscriptionJob {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Deepgram
  deepgramRequestId String @unique
  audioUrl          String // Enhanced audio URL

  // Configuration
  config Json // Deepgram options used

  // Status
  status TranscriptionStatus @default(PENDING)

  // Results
  rawJson           Json? // Full Deepgram response
  duration          Float? // Audio duration
  wordCount         Int?
  averageConfidence Float?
  speakerCount      Int?

  // Error handling
  errorMessage String?
  retryCount   Int     @default(0)
  maxRetries   Int     @default(3)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@index([completedAt])
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
  CANCELLED
}

model Transcript {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Version
  version       String // "1.0-raw", "2.0-ai-reviewed", "3.0-scopist", "4.0-final"
  versionNumber Int // 1, 2, 3, 4

  // Content
  content     String @db.Text // Plain text
  contentJson Json // TipTap JSON document

  // Tokens (for audio sync)
  tokens TranscriptToken[]

  // Metadata
  wordCount         Int?
  pageCount         Int?
  averageConfidence Float?
  speakerCount      Int?

  // AI Review (for version 2.0)
  aiChanges Json? // List of changes made
  aiFlags   Json? // Low-confidence sections

  // Creator
  createdBy String // "system", userId

  // Phase 3: Attorney Portal
  accessGrants            TranscriptAccess[]
  shares                  TranscriptShare[]
  highlights              TranscriptHighlight[]
  notes                   TranscriptNote[]
  bookmarks               TranscriptBookmark[]

  createdAt DateTime @default(now())

  @@unique([jobId, version])
  @@index([jobId, versionNumber])
  @@index([createdAt])
}

model TranscriptToken {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  // Position in transcript
  index Int // Word index in document

  // Content
  word           String
  punctuatedWord String? // With punctuation

  // Timing
  start Float // seconds
  end   Float // seconds

  // Quality
  confidence Float // 0.0 - 1.0
  isFlagged  Boolean @default(false) // confidence < 0.80
  isReviewed Boolean @default(false) // User marked as reviewed

  // Speaker
  speaker Int? // Speaker ID from diarization

  createdAt DateTime @default(now())

  @@index([transcriptId, index])
  @@index([transcriptId, isFlagged])
  @@index([createdAt])
}

model Transcription {
  id    String @id @default(cuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Core transcript data
  fullTranscript  String  @db.Text
  deepgramRawJson String? @db.Text // Full Deepgram response

  // Structured data (JSON strings)
  words              Json // Word-level data with timestamps
  utterances         Json? // Speaker turns
  flaggedSegments    Json? // Low-confidence words
  speakerAnalysis    Json? // AI speaker identification
  speakerAssignments Json? // User-defined speaker mapping

  // Metadata
  duration          Float? // Audio duration in seconds
  wordCount         Int?
  flaggedWordCount  Int?
  averageConfidence Float?
  speakerCount      Int     @default(0)
  modelUsed         String? // STANDARD, MEDICAL, BILINGUAL

  // Status
  status TranscriptionStatus @default(PENDING)

  // Versioning
  version Int @default(1)

  // Relations
  edits TranscriptionEdit[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([createdAt])
  @@index([updatedAt])
}

model TranscriptionEdit {
  id              String        @id @default(cuid())
  transcriptionId String
  transcription   Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  editorId    String
  editorEmail String?
  editorRole  UserRole?

  editType     EditType @default(WORD_CORRECTION)
  originalText String?
  editedText   String?
  position     Float? // audio timestamp

  metadata Json?

  createdAt DateTime @default(now())

  @@index([transcriptionId])
  @@index([createdAt])
}

enum EditType {
  WORD_CORRECTION
  SPEAKER_ASSIGNMENT
  PUNCTUATION
  INAUDIBLE_MARK
  FORMATTING
}

// ============================================
// AI REVIEW
// ============================================

model AIRule {
  id          String       @id @default(cuid())
  name        String
  category    RuleCategory
  description String
  enabled     Boolean      @default(true)
  priority    Int          @default(0) // Higher runs first

  // Rule definition
  ruleType    String // "regex", "llm", "dictionary"
  pattern     String? // For regex
  replacement String? // For simple replacements
  prompt      String? @db.Text // For LLM rules

  // Examples
  examples Json? // Before/after pairs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, priority])
  @@index([createdAt])
  @@index([updatedAt])
}

enum RuleCategory {
  CAPITALIZATION
  PUNCTUATION
  FORMATTING
  LEGAL_TERMS
  SPEAKER_ID
  NUMBERS
  DATES
  CUSTOM
}

// ============================================
// SCOPIST WORKFLOW
// ============================================

model JobAssignment {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  scopistId String
  scopist   User   @relation(fields: [scopistId], references: [id])

  status AssignmentStatus @default(INVITED)

  // Timing
  invitedAt   DateTime  @default(now())
  respondedAt DateTime?
  startedAt   DateTime?
  submittedAt DateTime?

  // Notes
  scopistNotes String? @db.Text

  @@index([jobId])
  @@index([scopistId, status])
  @@index([invitedAt])
  @@index([respondedAt])
  @@index([startedAt])
  @@index([submittedAt])
}

enum AssignmentStatus {
  INVITED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  RELEASED
}

// ============================================
// COMMUNICATION
// ============================================

model Message {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  content String @db.Text

  // Metadata
  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  // Link
  linkUrl  String?
  linkText String?

  // Status
  isRead      Boolean   @default(false)
  readAt      DateTime?
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?

  // Related job
  jobId String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  JOB_ASSIGNED
  TRANSCRIPTION_COMPLETE
  AI_REVIEW_COMPLETE
  SCOPIST_ACCEPTED
  SCOPIST_DECLINED
  SCOPIST_SUBMITTED
  REPORTER_REVIEWED
  JOB_COMPLETE
  SYSTEM_ERROR
  MESSAGE_RECEIVED
}

// ============================================
// AUDIT & SECURITY
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  action      String
  entityType  String
  entityId    String
  details     Json?
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  value       Json
  description String?

  updatedAt DateTime @updatedAt
}

model Firm {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  users User[]
  jobs  Job[]
  cases Case[]

  // Calendar relations
  calendarEvents       CalendarEvent[]
  reporterAvailability ReporterAvailability[]
  bookingRequests      BookingRequest[]

  // Phase 3: Attorney Portal
  tags                  TranscriptTag[]

  @@index([name])
  @@index([createdAt])
  @@index([updatedAt])
}

// ============================================
// CASE INTAKE SYSTEM
// ============================================

model Case {
  id String @id @default(cuid())

  // Multi-tenant: REQUIRED - every case belongs to a firm
  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // Created by
  createdById String
  createdBy   User   @relation("CaseCreator", fields: [createdById], references: [id])

  // Case Information
  caseNumber String
  caseStyle  String // Full case name (Plaintiff v. Defendant)
  shortTitle String? // Short reference name

  // Court Information
  courtName     String? // e.g., "419th Judicial District Court"
  courtType     String? // e.g., "District Court", "County Court"
  county        String?
  state         String  @default("Texas")
  judgeAssigned String?

  // Parties (stored as JSON arrays)
  plaintiffs   Json? // [{ name, type, role }]
  defendants   Json? // [{ name, type, role }]
  otherParties Json? // [{ name, type, role }]

  // Related Jobs
  jobs Job[]

  // Attorneys on the case
  attorneys CaseAttorney[]

  // Custom dictionary terms extracted from this case
  extractedTerms CaseExtractedTerm[]

  // Source documents
  sourceDocuments CaseDocument[]

  // Exhibits (attorney-global or deposition-specific)
  exhibits Exhibit[]

  // Case-level access control
  memberships CaseMembership[]

  // Phase 3: Attorney Portal
  transcriptAccess        TranscriptAccess[]
  tags                    TranscriptTag[]

  // Metadata
  status CaseStatus @default(ACTIVE)
  notes  String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([firmId, caseNumber])
  @@index([firmId])
  @@index([caseNumber])
  @@index([createdById])
  @@index([createdAt])
  @@index([updatedAt])
}

enum CaseStatus {
  ACTIVE
  CLOSED
  SETTLED
  ARCHIVED
}

// ============================================
// CASE-LEVEL PERMISSIONS (MULTI-TENANT)
// ============================================

/**
 * CaseMembership - Controls who can access which cases
 * This is the heart of the multi-tenant permission system.
 * Key Rules:
 * - Attorneys can belong to many cases
 * - Reporters belong only to their deposition's case (via Job)
 * - Paralegals can be added per case
 * - Access is granted per case, not globally
 */
model CaseMembership {
  id String @id @default(cuid())

  // User and Case
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Role within this specific case
  roleInCase CaseRole

  // Optional permission overrides (JSONB for flexibility)
  permissions Json? // e.g., { "canEditAnnotations": true, "canDeleteReports": false }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, caseId])
  @@index([userId])
  @@index([caseId])
  @@index([roleInCase])
  @@index([createdAt])
  @@index([updatedAt])
}

/**
 * Role within a specific case
 * Different from UserRole (which is global)
 */
enum CaseRole {
  ATTORNEY // Attorney on this case
  PARALEGAL // Paralegal assisting on this case
  REPORTER // Court reporter assigned to deposition in this case
}

model CaseAttorney {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Attorney info
  name         String
  barNumber    String?
  firm         String?
  role         AttorneyRole
  representing String? // Which party they represent

  // Contact info
  email   String?
  phone   String?
  fax     String?
  address String? @db.Text
  city    String?
  state   String?
  zipCode String?

  // Delivery preferences
  deliveryFormat   String? // "E-Trans", "Hard Copy", "Both"
  deliveryPriority String? // "Standard", "Rush"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([email])
  @@index([createdAt])
  @@index([updatedAt])
}

enum AttorneyRole {
  PLAINTIFF_COUNSEL
  DEFENSE_COUNSEL
  ORDERING_ATTORNEY
  COPY_ATTORNEY
  OTHER
}

model CaseDocument {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // File info
  documentType CaseDocumentType
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String

  // Extraction status
  extractionStatus ExtractionStatus @default(PENDING)
  extractedData    Json? // Raw extracted data from AI
  extractedAt      DateTime?
  extractionError  String?          @db.Text

  // Upload info
  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([caseId])
  @@index([documentType])
  @@index([uploadedAt])
}

enum CaseDocumentType {
  NOTICE_OF_DEPOSITION
  CSR_PAPERWORK
  DEPO_NOTES
  COURT_ORDER
  SUBPOENA
  EXHIBIT_LIST
  OTHER
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CaseExtractedTerm {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  term       String
  category   TermCategory
  phonetic   String? // Optional pronunciation hint
  source     String? // Which document it came from
  confidence Float? // AI confidence score

  // Whether to use in Deepgram
  useInTranscription Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([caseId, term])
  @@index([caseId])
  @@index([category])
  @@index([createdAt])
}

enum TermCategory {
  PERSON_NAME
  COMPANY_NAME
  PLACE_NAME
  LEGAL_TERM
  MEDICAL_TERM
  TECHNICAL_TERM
  CASE_SPECIFIC
}

// ============================================
// ATTORNEY TRANSCRIPT MODELS
// ============================================

/**
 * Attorney Transcript - Read-only transcript for attorney review
 * Stored as JSONB for flexibility (page/line structure)
 */
model AttorneyTranscript {
  id String @id @default(cuid())

  // Basic Info
  name           String
  deponent       String
  caseName       String?
  depositionDate DateTime?

  // Status
  status AttorneyTranscriptStatus @default(NOT_REVIEWED)

  // Transcript data (stored as JSONB)
  // Structure: { pages: [{ pageNumber, lines: [{ page, line, speaker, text }] }] }
  transcriptData Json // Full transcript structure

  // Metadata
  totalPages Int
  totalLines Int

  // Upload info
  uploadedById String
  uploadedBy   User     @relation("TranscriptCreator", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  // Relationships
  annotations TranscriptAnnotation[]

  @@index([uploadedById])
  @@index([status])
  @@index([deponent])
  @@index([uploadedAt])
}

enum AttorneyTranscriptStatus {
  NOT_REVIEWED
  IN_PROGRESS
  COMPLETE
}

/**
 * Transcript Annotation - Issue codes tagged on transcript lines
 */
model TranscriptAnnotation {
  id String @id @default(cuid())

  // Transcript reference
  transcriptId String
  transcript   AttorneyTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  // Issue code
  issueCode  String // Code identifier (e.g., "PERJURY", "CONTRADICTION")
  issueLabel String // Display label
  issueColor String // Hex color

  // Annotation range
  pageStart Int
  lineStart Int
  pageEnd   Int
  lineEnd   Int

  // Notes
  note String? @db.Text

  // Creator
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // Linked exhibits
  linkedExhibits TranscriptAnnotationExhibit[]

  @@index([transcriptId])
  @@index([createdById])
  @@index([issueCode])
  @@index([createdAt])
}

/**
 * Junction table linking transcript annotations to exhibits
 * Allows attorneys to reference exhibits in their annotations
 */
model TranscriptAnnotationExhibit {
  id String @id @default(cuid())

  // Annotation reference
  annotationId String
  annotation   TranscriptAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)

  // Exhibit reference
  exhibitId String
  exhibit   Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  // Creator
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([annotationId, exhibitId])
  @@index([annotationId])
  @@index([exhibitId])
  @@index([createdById])
  @@index([createdAt])
}

// ============================================
// PASSWORD RESET
// ============================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([createdAt])
  @@index([expires])
}

// ============================================
// CALENDAR SYSTEM
// Phase 2: Calendar & Scheduling
// ============================================

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum CalendarEventStatus {
  REQUESTED      // Attorney submitted request, awaiting agency action
  SCHEDULED      // Agency created/confirmed the event
  CONFIRMED      // Reporter accepted the assignment
  IN_PROGRESS    // Deposition is currently happening
  COMPLETED      // Deposition finished, ready for transcription
  CANCELLED      // Event was cancelled (see cancellationReason)
  RESCHEDULED    // Moved to a new time (original event archived)
}

enum EventType {
  DEPOSITION           // Standard deposition
  HEARING              // Court hearing
  ARBITRATION          // Arbitration proceeding
  MEDIATION            // Mediation session
  EUO                  // Examination Under Oath
  STATEMENT            // Recorded statement
  OTHER                // Other legal proceeding
}

enum AvailabilityType {
  AVAILABLE            // Reporter is available
  UNAVAILABLE          // Reporter is blocked (vacation, etc.)
  TENTATIVE            // Possibly available, needs confirmation
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ParticipantRole {
  ATTORNEY_PLAINTIFF
  ATTORNEY_DEFENSE
  WITNESS
  DEPONENT
  INTERPRETER
  VIDEOGRAPHER
  OBSERVER
}

enum BookingRequestStatus {
  PENDING         // Awaiting agency review
  APPROVED        // Approved, event created
  REJECTED        // Rejected by agency
  CANCELLED       // Cancelled by attorney
  MODIFIED        // Agency proposed different time
}

// ============================================
// PHASE 3: ATTORNEY PORTAL ENUMS
// ============================================

enum TranscriptAccessLevel {
  VIEW
  COMMENT
  EDIT
}

enum ShareType {
  USER
  LINK
  ORGANIZATION
}

enum ShareStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum HighlightColor {
  YELLOW
  GREEN
  BLUE
  PINK
  ORANGE
  PURPLE
}

// ------------------------------------------------------------
// CALENDAR EVENT (Core scheduling model)
// ------------------------------------------------------------

model CalendarEvent {
  id                String              @id @default(cuid())

  // === MULTI-TENANT ===
  firmId            String
  firm              Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // === EVENT DETAILS ===
  title             String              // e.g., "Smith v. Jones Deposition"
  eventType         EventType           @default(DEPOSITION)
  status            CalendarEventStatus @default(REQUESTED)

  // === TIMING (All times stored as UTC) ===
  startTime         DateTime
  endTime           DateTime
  timezone          String              @default("America/Chicago") // IANA timezone
  allDay            Boolean             @default(false)

  // === RECURRENCE (Optional) ===
  isRecurring       Boolean             @default(false)
  recurrenceRule    String?             // RRULE format: "FREQ=WEEKLY;BYDAY=MO,WE,FR"
  recurrenceEndDate DateTime?
  parentEventId     String?             // For recurring instances, points to parent
  parentEvent       CalendarEvent?      @relation("RecurringEvents", fields: [parentEventId], references: [id])
  childEvents       CalendarEvent[]     @relation("RecurringEvents")

  // === LOCATION ===
  location          String?             // Physical address or "Remote"
  isRemote          Boolean             @default(false)
  meetingLink       String?             // Zoom/Teams link if remote

  // === RELATIONSHIPS ===
  // Link to Job (for transcription workflow)
  jobId             String?             @unique
  job               Job?                @relation(fields: [jobId], references: [id])

  // Assigned court reporter
  assignedReporterId String?
  assignedReporter   User?              @relation("ReporterAssignments", fields: [assignedReporterId], references: [id])

  // Attorney who requested (for REQUESTED status)
  requestedById     String?
  requestedBy       User?               @relation("AttorneyRequests", fields: [requestedById], references: [id])

  // Agency user who scheduled/approved
  scheduledById     String?
  scheduledBy       User?               @relation("AgencyScheduled", fields: [scheduledById], references: [id])

  // Participants (attorneys, witnesses, etc.)
  participants      EventParticipant[]

  // Booking request that created this event
  bookingRequest    BookingRequest?

  // === METADATA ===
  notes             String?             @db.Text
  internalNotes     String?             @db.Text  // Agency-only notes
  cancellationReason String?

  // === AUDIT ===
  createdById       String
  createdBy         User                @relation("EventCreator", fields: [createdById], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  confirmedAt       DateTime?           // When reporter confirmed
  cancelledAt       DateTime?

  // === INDEXES for fast queries ===
  @@index([firmId, startTime, endTime])  // Conflict detection
  @@index([assignedReporterId, startTime])        // Reporter schedule
  @@index([status])                               // Status filtering
  @@index([jobId])                                // Job lookup
  @@index([createdAt])
  @@index([updatedAt])
  @@index([confirmedAt])
  @@index([cancelledAt])

  @@map("calendar_events")
}

// ------------------------------------------------------------
// EVENT PARTICIPANTS (Attorneys, witnesses, interpreters, etc.)
// ------------------------------------------------------------

model EventParticipant {
  id              String          @id @default(cuid())

  eventId         String
  event           CalendarEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Can be a system user OR external person
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])

  // For external participants (not in system)
  externalName    String?
  externalEmail   String?
  externalPhone   String?

  // Role in the event
  role            ParticipantRole

  // Status
  notified        Boolean         @default(false)
  notifiedAt      DateTime?
  confirmed       Boolean         @default(false)
  confirmedAt     DateTime?

  createdAt       DateTime        @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([createdAt])
  @@map("event_participants")
}

// ------------------------------------------------------------
// REPORTER AVAILABILITY (For scheduling optimization)
// ------------------------------------------------------------

model ReporterAvailability {
  id              String            @id @default(cuid())

  // Which reporter
  reporterId      String
  reporter        User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  // Firm context
  firmId          String
  firm            Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // Time block
  startTime       DateTime
  endTime         DateTime
  timezone        String            @default("America/Chicago")

  // Type of availability
  type            AvailabilityType  @default(AVAILABLE)

  // Recurrence for regular schedules
  isRecurring     Boolean           @default(false)
  recurrenceRule  String?           // "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR"
  recurrenceEnd   DateTime?

  // Notes
  notes           String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([reporterId, startTime, endTime])
  @@index([firmId, type])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("reporter_availability")
}

// ------------------------------------------------------------
// BOOKING REQUEST (Attorney → Agency workflow)
// ------------------------------------------------------------

model BookingRequest {
  id              String              @id @default(cuid())

  firmId          String
  firm            Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // Requesting attorney
  requestedById   String
  requestedBy     User                @relation(fields: [requestedById], references: [id])

  // Request details
  caseName        String
  caseNumber      String?
  preferredDate   DateTime
  alternateDate1  DateTime?
  alternateDate2  DateTime?
  estimatedDuration Int               @default(240)  // Minutes

  eventType       EventType           @default(DEPOSITION)
  location        String?
  isRemote        Boolean             @default(false)

  // Deponent info
  deponentName    String
  deponentContact String?

  // Special requirements
  needsInterpreter Boolean            @default(false)
  interpreterLanguage String?
  needsVideographer Boolean           @default(false)
  needsRealtime   Boolean             @default(false)  // Realtime transcription
  specialNotes    String?             @db.Text

  // Status
  status          BookingRequestStatus @default(PENDING)

  // If approved, link to created event
  calendarEventId String?             @unique
  calendarEvent   CalendarEvent?      @relation(fields: [calendarEventId], references: [id])

  // Agency response
  respondedById   String?
  respondedBy     User?               @relation("AgencyResponder", fields: [respondedById], references: [id])
  respondedAt     DateTime?
  rejectionReason String?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([firmId, status])
  @@index([requestedById])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([respondedAt])
  @@map("booking_requests")
}

// ============================================
// PHASE 3: ATTORNEY PORTAL MODELS
// ============================================

// 3.1.1 ATTORNEY PROFILE & SETTINGS
model AttorneyProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Professional Information
  barNumber     String?
  barState      String?              // State of bar admission
  firmName      String?              // Law firm name
  firmAddress   String?
  firmPhone     String?

  // Practice Areas (for filtering/matching)
  practiceAreas String[]             // ["Personal Injury", "Medical Malpractice", "Civil Litigation"]

  // Preferences
  defaultExportFormat   String?      @default("PDF")  // PDF, DOCX, TXT
  emailNotifications    Boolean      @default(true)
  smsNotifications      Boolean      @default(false)

  // Billing Contact (if different from user)
  billingEmail    String?
  billingAddress  String?

  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([barNumber])
  @@index([barState])
  @@index([createdAt])
  @@index([updatedAt])
}

// 3.1.2 TRANSCRIPT ACCESS & SHARING
model TranscriptAccess {
  id              String   @id @default(cuid())

  // The transcript being accessed
  transcriptId    String
  transcript      Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  // Who has access (attorney user)
  userId          String
  user            User     @relation("TranscriptAccessUser", fields: [userId], references: [id], onDelete: Cascade)

  // Access level
  accessLevel     TranscriptAccessLevel @default(VIEW)

  // Who granted access
  grantedById     String
  grantedBy       User     @relation("TranscriptAccessGranter", fields: [grantedById], references: [id])

  // Optional: Link to case for context
  caseId          String?
  case            Case?    @relation(fields: [caseId], references: [id])

  // Access constraints
  expiresAt       DateTime?            // Optional expiration
  downloadLimit   Int?                 // Max downloads allowed (null = unlimited)
  downloadCount   Int      @default(0) // Current download count

  // Activity tracking
  lastAccessedAt  DateTime?
  accessCount     Int      @default(0)

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([transcriptId, userId])
  @@index([userId])
  @@index([transcriptId])
  @@index([caseId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lastAccessedAt])
  @@index([expiresAt])
}

model TranscriptShare {
  id              String   @id @default(cuid())

  transcriptId    String
  transcript      Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  // Who shared it
  sharedById      String
  sharedBy        User     @relation(fields: [sharedById], references: [id])

  // Share type
  shareType       ShareType

  // For EMAIL share type
  recipientEmail  String?
  recipientName   String?

  // For LINK share type - unique token for secure access
  shareToken      String?  @unique @default(cuid())

  // Access settings
  accessLevel     TranscriptAccessLevel @default(VIEW)
  expiresAt       DateTime?
  password        String?              // Optional password protection

  // Usage tracking
  accessCount     Int      @default(0)
  lastAccessedAt  DateTime?

  // Status
  status          ShareStatus @default(ACTIVE)
  revokedAt       DateTime?

  // Metadata
  message         String?  @db.Text     // Optional message to recipient
  createdAt       DateTime @default(now())

  @@index([transcriptId])
  @@index([sharedById])
  @@index([shareToken])
  @@index([recipientEmail])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([lastAccessedAt])
}

// 3.1.3 ANNOTATIONS (Highlights, Tags, Notes, Bookmarks)
model TranscriptHighlight {
  id              String   @id @default(cuid())

  transcriptId    String
  transcript      Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  // Who created the highlight
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Position in transcript
  startIndex      Int                  // Character start position
  endIndex        Int                  // Character end position
  startLine       Int?                 // Line number start (if applicable)
  endLine         Int?                 // Line number end

  // The highlighted text (denormalized for quick display)
  highlightedText String   @db.Text

  // Visual styling
  color           HighlightColor @default(YELLOW)

  // Optional note attached to highlight
  note            String?  @db.Text

  // Tags associated with this highlight
  tags            TranscriptHighlightTag[]

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([transcriptId])
  @@index([userId])
  @@index([transcriptId, userId])
  @@index([createdAt])
  @@index([updatedAt])
}

model TranscriptTag {
  id              String   @id @default(cuid())

  // Tag can be personal (user-specific) or shared (case-level or firm-level)
  userId          String?              // If set, personal tag
  user            User?    @relation("UserTags", fields: [userId], references: [id], onDelete: Cascade)

  firmId          String?              // If set, firm-wide tag
  firm            Firm?    @relation(fields: [firmId], references: [id], onDelete: Cascade)

  caseId          String?              // If set, case-specific tag
  case            Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Tag details
  name            String               // "Key Admission", "Impeachment", "Follow Up"
  color           String?              // Hex color code
  description     String?

  // System vs custom
  isSystem        Boolean  @default(false)  // Pre-defined tags vs user-created

  // Usage
  highlights      TranscriptHighlightTag[]

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, name])
  @@unique([firmId, name])
  @@unique([caseId, name])
  @@index([userId])
  @@index([firmId])
  @@index([caseId])
  @@index([createdAt])
  @@index([updatedAt])
}

model TranscriptHighlightTag {
  id              String   @id @default(cuid())

  highlightId     String
  highlight       TranscriptHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  tagId           String
  tag             TranscriptTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([highlightId, tagId])
  @@index([highlightId])
  @@index([tagId])
  @@index([createdAt])
}

model TranscriptNote {
  id              String   @id @default(cuid())

  transcriptId    String
  transcript      Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Position (optional - can be general note or attached to specific location)
  lineNumber      Int?
  pageNumber      Int?
  timestamp       String?              // Audio timestamp if applicable

  // Note content
  title           String?
  content         String   @db.Text

  // Visibility
  isPrivate       Boolean  @default(true)  // Private to user vs shared with case team

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([transcriptId])
  @@index([userId])
  @@index([transcriptId, userId])
  @@index([createdAt])
  @@index([updatedAt])
}

model TranscriptBookmark {
  id              String   @id @default(cuid())

  transcriptId    String
  transcript      Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Position
  lineNumber      Int
  pageNumber      Int?
  timestamp       String?              // Audio timestamp

  // Bookmark details
  label           String               // User-friendly label
  description     String?

  // Quick reference text (snippet at bookmark location)
  snippetText     String?  @db.VarChar(500)

  // Ordering (for custom sort)
  sortOrder       Int      @default(0)

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([transcriptId])
  @@index([userId])
  @@index([transcriptId, userId])
  @@index([createdAt])
  @@index([updatedAt])
}
