{
  // Ask VS Code to run ESLint fixes when you save
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Make sure ESLint knows what to check
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // Don't fight with other formatters yet (we can add Prettier later if you want)
  "editor.formatOnSave": false,

  // TypeScript settings
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Line ending normalization (prevents CRLF/LF issues)
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // Auto-save configuration (optional - uncomment if you want auto-save)
  // "files.autoSave": "afterDelay",
  // "files.autoSaveDelay": 1000
}
